diff --git a/packages/coding-agent/test/read-batch.test.ts b/packages/coding-agent/test/read-batch.test.ts
new file mode 100644
index 0000000..c091761
--- /dev/null
+++ b/packages/coding-agent/test/read-batch.test.ts
@@ -0,0 +1,146 @@
+import { describe, expect, it } from "bun:test";
+import type { AgentTool, AgentToolResult } from "@oh-my-pi/pi-agent-core";
+import { type } from "@oh-my-pi/omptype";
+import { Settings } from "../src/config/settings";
+import { createReadBatchPrelude } from "../src/eval/read-batch";
+import { cfgTokenOptimizationProgrammatic } from "../src/session/context-settings";
+import type { ToolSession } from "../src/tools";
+
+const parameters = type({ path: "string" });
+type Read = (path: string, signal?: AbortSignal) => Promise<AgentToolResult<unknown>>;
+
+function fixture(read: Read) {
+	const tool: AgentTool<typeof parameters> = {
+		name: "read",
+		label: "读取",
+		description: "测试原生工具桥参数与结果",
+		parameters,
+		execute: (_id, args, signal) => read(args.path, signal),
+	};
+	const session: ToolSession = {
+		cwd: process.cwd(),
+		hasUI: false,
+		getSessionFile: () => null,
+		getSessionSpawns: () => null,
+		settings: Settings.isolated(),
+		getToolByName: name => name === "read" ? tool : undefined,
+		getToolForEvalBridge: name => name === "read" ? tool : undefined,
+	};
+	const prelude = createReadBatchPrelude(session);
+	return {
+		session,
+		prelude,
+		run: (paths: unknown, signal?: AbortSignal) => prelude.invoke({ paths }, { session, signal, toolCallId: "read-batch-test" }),
+	};
+}
+
+const text = (value: string): AgentToolResult<unknown> => ({ content: [{ type: "text", text: value }] });
+
+describe("原生读取批次", () => {
+	it("默认关闭，沿用实时设置启用与撤回", () => {
+		const { session, prelude } = fixture(async path => text(path));
+		expect(prelude.enabled?.()).toBe(false);
+		cfgTokenOptimizationProgrammatic.override(session.settings, true);
+		expect(prelude.enabled?.()).toBe(true);
+		cfgTokenOptimizationProgrammatic.override(session.settings, false);
+		expect(prelude.enabled?.()).toBe(false);
+	});
+
+	it("固定四个原生读取并发，逆序完成仍按输入顺序返回", async () => {
+		const paths = Array.from({ length: 7 }, (_, index) => `p${index}`);
+		const gates = paths.map(() => Promise.withResolvers<void>());
+		const started = paths.map(() => Promise.withResolvers<void>());
+		const calls: string[] = [];
+		let active = 0;
+		let peak = 0;
+		const { run } = fixture(async path => {
+			const index = Number(path.slice(1));
+			calls.push(path);
+			active++;
+			peak = Math.max(peak, active);
+			started[index].resolve();
+			try { await gates[index].promise; return text(path); }
+			finally { active--; }
+		});
+		const pending = run(paths);
+		try {
+			await Promise.all(started.slice(0, 4).map(item => item.promise));
+			expect(calls).toEqual(paths.slice(0, 4));
+			gates[2].resolve();
+			await started[4].promise;
+			gates[0].resolve();
+			await started[5].promise;
+			gates[3].resolve();
+			await started[6].promise;
+		} finally { for (const gate of gates) gate.resolve(); }
+		const result = await pending;
+		expect(result.details).toEqual(paths.map(path => ({ path, result: path })));
+		expect(peak).toBe(4);
+		expect(active).toBe(0);
+	});
+
+	it("原生 text、details、images 与逐项错误保留，失败不吞掉其它成功项", async () => {
+		const details = { meta: { source: { path: "same.txt", version: "abc" } }, extra: [1, 2] };
+		const image = { type: "image" as const, mimeType: "image/png", data: "AA==" };
+		const { run } = fixture(async path => {
+			if (path === "throw") throw new Error("读取失败");
+			if (path === "error") return { ...text("原生错误"), details: { isError: true, reason: "fixture" } };
+			return { content: [{ type: "text", text: "[same.txt#ABCD]\n1:原文" }, image], details };
+		});
+		const result = await run(["same.txt", "throw", "error", "same.txt"]);
+		const rows = result.details as { path: string; result?: unknown; error?: string }[];
+		expect(rows.map(row => row.path)).toEqual(["same.txt", "throw", "error", "same.txt"]);
+		expect(rows[0].result).toEqual({ text: "[same.txt#ABCD]\n1:原文", details, images: [{ mimeType: image.mimeType, data: image.data }] });
+		expect(rows[1]).toEqual({ path: "throw", error: "读取失败" });
+		expect(rows[2]).toEqual({ path: "error", result: { text: "原生错误", details: { isError: true, reason: "fixture" }, hasError: true }, error: "原生错误" });
+		expect(rows[3]).toEqual(rows[0]);
+	});
+
+	it("空错误文本仍可被 error 筛选用于恢复", async () => {
+		const { run } = fixture(async () => ({ content: [], isError: true }));
+		const result = await run(["failed"]);
+		const rows = result.details as { error?: string }[];
+		expect(rows[0].error).toBeTruthy();
+	});
+
+	it("空批次无调用，非法路径在任何读取开始前拒绝", async () => {
+		const calls: string[] = [];
+		const { run } = fixture(async path => { calls.push(path); return text(path); });
+		expect((await run([])).details).toEqual([]);
+		for (const paths of [null, "p0", ["p0", 42], ["p0", ""], ["p0", null]]) {
+			await expect(run(paths)).rejects.toThrow("array of nonempty paths");
+		}
+		expect(calls).toEqual([]);
+	});
+
+	it("取消会停止派发余项并传递同一原生 signal", async () => {
+		const controller = new AbortController();
+		const gate = Promise.withResolvers<void>();
+		const calls: string[] = [];
+		const signals: (AbortSignal | undefined)[] = [];
+		const { run } = fixture(async (path, signal) => {
+			calls.push(path);
+			signals.push(signal);
+			if (calls.length === 4) {
+				controller.abort(new Error("合同取消"));
+				gate.resolve();
+			}
+			await gate.promise;
+			signal!.throwIfAborted();
+			return text(path);
+		});
+		const pending = run(Array.from({ length: 10 }, (_, index) => `p${index}`), controller.signal);
+		await expect(pending).rejects.toThrow("合同取消");
+		expect(calls).toEqual(["p0", "p1", "p2", "p3"]);
+		expect(signals.every(signal => signal === controller.signal)).toBe(true);
+	});
+
+	it("工具在会话中不可用时仍保留原生错误", async () => {
+		let called = false;
+		const { session, run } = fixture(async () => { called = true; return text("不应到达"); });
+		session.getToolForEvalBridge = () => undefined;
+		const result = await run(["p0"]);
+		expect((result.details as { error: string }[])[0].error).toContain("not available in this session");
+		expect(called).toBe(false);
+	});
+});
