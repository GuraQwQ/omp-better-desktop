+++ b/packages/coding-agent/src/eval/read-batch.ts
@@ -0,0 +1,59 @@
+import { isRecord } from "@oh-my-pi/pi-utils";
+import { cfgTokenOptimizationProgrammatic } from "../session/context-settings";
+import type { ToolSession } from "../tools";
+import { callSessionTool } from "./js/tool-bridge";
+import type { EvalPreludeDefinition } from "./preludes";
+
+/** 固定只读批次；每项仍通过原生工具的校验、审批和读取路径。 */
+export function createReadBatchPrelude(session: ToolSession): EvalPreludeDefinition {
+	return {
+		name: "read_batch",
+		documentation:
+			"`await readBatch(paths)` reads independent paths (up to 4 concurrently), returning ordered `{path,result,error?}` items. `result` preserves native text/details/images; errors stay per item. Use `:raw` for exact text or native JSON selectors for filtered data. Keep the array in the kernel, print only decision evidence, and retry only items with `error`.",
+		inlineDocumentation: true,
+		javascript: `globalThis.readBatch = async paths => (await globalThis.__omp_prelude__("read_batch", { paths })).details;`,
+		python: `async def readBatch(paths):\n    return (await _omp_prelude("read_batch", {"paths": paths}))["details"]\n`,
+		exports: ["readBatch"],
+		approval: "read",
+		enabled: () => cfgTokenOptimizationProgrammatic.get(session.settings),
+		invoke: async (parameters, context) => {
+			if (
+				!isRecord(parameters) ||
+				!Array.isArray(parameters.paths) ||
+				!parameters.paths.every((path: unknown) => typeof path === "string" && path.length > 0)
+			) {
+				throw new TypeError("readBatch expects an array of nonempty paths.");
+			}
+			const paths: string[] = parameters.paths;
+			const results: { path: string; result?: unknown; error?: string }[] = [];
+			let cursor = 0;
+			await Promise.all(
+				Array.from({ length: Math.min(4, paths.length) }, async () => {
+					while (cursor < paths.length) {
+						context.signal?.throwIfAborted();
+						const index = cursor++;
+						const path = paths[index];
+						try {
+							const result = await callSessionTool("read", { path }, { session, signal: context.signal });
+							const error =
+								isRecord(result) && "hasError" in result && result.hasError === true
+									? "text" in result
+										? String(result.text) || "Read failed."
+										: "Read failed."
+									: undefined;
+							results[index] = { path, result, ...(error === undefined ? {} : { error }) };
+						} catch (error) {
+							context.signal?.throwIfAborted();
+							results[index] = {
+								path,
+								error: (error instanceof Error ? error.message : String(error)) || "Read failed.",
+							};
+						}
+					}
+				}),
+			);
+			const failures = results.filter(result => result.error !== undefined).length;
+			return { content: [{ type: "text", text: `${paths.length} reads, ${failures} failed.` }], details: results };
+		},
+	};
+}
