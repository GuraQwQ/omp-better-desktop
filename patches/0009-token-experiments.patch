@@ -0,0 +1,54 @@
+import { describe, expect, it } from "bun:test";
+import { TempDir } from "@oh-my-pi/pi-utils";
+import { Settings } from "../src/config/settings";
+import { cfgTokenOptimizationProgrammatic } from "../src/session/context-settings";
+import { buildSystemPrompt, cfgSystemPromptInputs, type BuildSystemPromptOptions } from "../src/system-prompt";
+
+function options(cwd: string, toolNames = ["eval", "read"]): BuildSystemPromptOptions {
+	return {
+		cwd,
+		toolNames,
+		contextFiles: [],
+		noContextFiles: true,
+		skills: [],
+		rules: [],
+		alwaysApplyRules: [],
+		activeRepoContext: null,
+		workspaceTree: { rootPath: cwd, rendered: "", truncated: false, totalLines: 0, agentsMdFiles: [] },
+	};
+}
+
+describe("程序化工具编排提示词隔离", () => {
+	it("设置只在显式开启时添加独立指导，关闭后恢复原有字节", async () => {
+		using directory = TempDir.createSync("omp-token-prompt-");
+		const base = options(directory.path());
+		const settings = Settings.isolated();
+		const original = await buildSystemPrompt(base);
+		const defaults = await buildSystemPrompt({
+			...base,
+			programmatic: cfgSystemPromptInputs.get(settings).programmatic,
+		});
+		expect(defaults).toEqual(original);
+
+		cfgTokenOptimizationProgrammatic.override(settings, true);
+		const enabled = await buildSystemPrompt({
+			...base,
+			programmatic: cfgSystemPromptInputs.get(settings).programmatic,
+		});
+		const extra = enabled.systemPrompt.filter(block => !original.systemPrompt.includes(block));
+		expect(extra).toHaveLength(1);
+		expect(extra[0]).toContain("tool.<name>(args)");
+		expect(enabled.systemPrompt.filter(block => block !== extra[0])).toEqual(original.systemPrompt);
+
+		cfgTokenOptimizationProgrammatic.override(settings, false);
+		expect(
+			await buildSystemPrompt({ ...base, programmatic: cfgSystemPromptInputs.get(settings).programmatic }),
+		).toEqual(original);
+	});
+
+	it("没有 eval 的会话不收到无法执行的程序化指导", async () => {
+		using directory = TempDir.createSync("omp-token-prompt-tools-");
+		const base = options(directory.path(), ["read"]);
+		expect(await buildSystemPrompt({ ...base, programmatic: true })).toEqual(await buildSystemPrompt(base));
+	});
+});
