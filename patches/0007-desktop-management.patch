+/** 桌面配置只调用原生配置管理器，不进入模型对话。 */
+export async function desktopManage(
+	session: AgentSession,
+	request: DesktopManageRequest,
+	options: DesktopManageOptions = {},
+): Promise<object> {
+	const args = request.args ?? {};
+	if (!isRecord(args)) throw new Error("args 必须为对象");
+	options.signal?.throwIfAborted();
+	switch (request.resource) {
+		case "models":
+			return manageModels(session, request.action, args);
+		case "mcp":
+			return manageMcp(session, request.action, args, options);
+		case "skills":
+			return manageSkills(session, request.action, args);
+		case "plugins":
+		case "marketplaces": {
+			const runAction = () =>
+				request.resource === "plugins"
+					? managePlugins(session, request.action, args, options)
+					: manageMarketplaces(session, request.action, args);
+			if (["list", "detail", "list_available"].includes(request.action)) return runAction();
+			const run = (pluginMutations.get(session) ?? Promise.resolve({})).catch(() => ({})).then(runAction);
+			pluginMutations.set(session, run);
+			try {
+				return await run;
+			} finally {
+				if (pluginMutations.get(session) === run) pluginMutations.delete(session);
+			}
+		}
+		case "agents":
+			return manageAgents(session, request.action, args);
+		case "ssh":
+			return manageSsh(session, request.action, args);
+		case "resources":
+			return manageResources(session, request.action, args);
+		default:
+			throw new Error(`未知配置资源：${request.resource}`);
+	}
+}
