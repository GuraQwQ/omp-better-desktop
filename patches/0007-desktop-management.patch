+} from "@oh-my-pi/pi-utils";
+import { withFileLock } from "@oh-my-pi/pi-utils/file-lock";
+import { MANAGED_SKILLS_PROVIDER_ID } from "../../autolearn/managed-skills";
+import { loadCapability, reset as resetCapabilities } from "../../capability";
+import type { Hook } from "../../capability/hook";
+import { mcpCapability, type MCPServer } from "../../capability/mcp";
+import type { SSHHost } from "../../capability/ssh";
+import { cfgModelRoleStorage } from "../../config/model-settings";
+import {
+	acquireModelRoleMutation,
+	applyModelPreset,
+	deleteModelPreset,
+	findActiveModelPreset,
+	getModelPreset,
+	getModelPresetNames,
+	saveModelPreset,
+} from "../../config/model-presets";
+import { resolveModelRoleValue } from "../../config/model-resolver";
+import { getKnownRoleIds, getRoleInfo, roleCandidatePool } from "../../config/model-roles";
+import { lookup } from "../../config/registry";
+import { clearPluginRootsAndCaches, resolveOrDefaultProjectRegistryPath } from "../../discovery/helpers";
+import { PluginManager, validateSetting } from "../../extensibility/plugins/manager";
+import { parseGitUrl } from "../../extensibility/plugins/git-url";
+import {
+	getInstalledPluginsRegistryPath,
+	getMarketplacesCacheDir,
+	getMarketplacesRegistryPath,
+	getPluginsCacheDir,
+	MarketplaceManager,
+	parsePluginId,
+} from "../../extensibility/plugins/marketplace";
+import { normalizePluginRuntimeConfig, writePluginRuntimeConfig } from "../../extensibility/plugins/runtime-config";
+import type { InstalledPlugin } from "../../extensibility/plugins/types";
+import { cfgDisabledExtensions, cfgSkills } from "../../extensibility/settings";
+import { loadSkillPromptBody, loadSkills, type Skill } from "../../extensibility/skills";
+import { validateServerConfig } from "../../mcp/config";
+import { addMCPServer, readMCPConfigFile, removeMCPServer, setMcpServerEnabled } from "../../mcp/config-writer";
+import type { MCPManager } from "../../mcp/manager";
+import {
+	findMcpServerForAuth,
+	type FoundMcpServer,
+	probeMcpConnection,
+	reauthorizeMcpServer,
+	reconnectMcpManagerServer,
+} from "../../mcp/oauth-reauth";
+import { cfgMcpEnableProjectConfig } from "../../mcp/settings";
+import type { MCPServerConfig } from "../../mcp/types";
+import { getMemoryRoot } from "../../memories";
+import { resolveMemoryBackend } from "../../memory-backend/resolve";
+import type { AgentSession } from "../../session/agent-session";
+import { buildAvailableSlashCommands } from "../../slash-commands/available-commands";
+import { readSSHConfigFile, validateHostName, writeSSHConfigFile } from "../../ssh/config-writer";
+import { ensureConnection, getHostInfoForHost, invalidateHostMetadata } from "../../ssh/connection-manager";
+import { discoverAgents } from "../../task/discovery";
+import { ManageSkillTool } from "../../tools/manage-skill";
+import { expandTilde } from "../../tools/path-utils";
+
+export interface DesktopManageRequest {
+	resource: string;
+	action: string;
+	args?: Record<string, unknown>;
+}
+
+export interface DesktopManageOptions {
+	mcpManager?: MCPManager;
+	signal?: AbortSignal;
+	onAuth?: (info: { url: string; instructions?: string }) => void;
+	reloadPlugins?: () => Promise<void>;
+}
+
+const stdioInput = type({ command: "string", "args?": "string[]", "env?": "Record<string, string>", "cwd?": "string" });
+const remoteInput = type({ url: "string", "headers?": "Record<string, string>" });
+const sshInput = type({
+	host: "string",
+	"username?": "string",
+	"port?": "number.integer",
+	"keyPath?": "string",
+	"description?": "string",
+	"compat?": "boolean",
+});
+const authFlows = new WeakMap<AgentSession, Map<string, AbortController>>();
+const pluginMutations = new WeakMap<AgentSession, Promise<object>>();
+
+function text(args: Record<string, unknown>, key: string, allowEmpty = false): string {
+	const value = args[key];
+	if (typeof value !== "string" || (!allowEmpty && !value.trim())) throw new Error(`请填写 ${key}`);
+	return allowEmpty ? value : value.trim();
+}
+
+function scopeOf(args: Record<string, unknown>): "user" | "project" {
+	if (args.scope === undefined || args.scope === "user") return "user";
+	if (args.scope === "project") return "project";
+	throw new Error("scope 必须为 user 或 project");
+}
+
+function modelView(model: Model): object {
+	return {
+		id: model.id,
+		value: `${model.provider}/${model.id}`,
+		provider: model.provider,
+		name: model.name,
+		kind: modelKind(model),
+		thinkingLevels: getSupportedEfforts(model),
+	};
+}
+
+async function setSetting(session: AgentSession, key: string, value: unknown): Promise<void> {
+	const setting = lookup(key);
+	if (!setting) throw new Error(`未知配置：${key}`);
+	setting.assertWritable(value);
+	setting.set(session.settings, value);
+	await session.settings.flush();
+}
+
+function configured(session: AgentSession, key: string): unknown {
+	return lookup(key)?.get(session.settings);
+}
+
+async function manageModels(session: AgentSession, action: string, args: Record<string, unknown>): Promise<object> {
+	const settings = session.settings;
+	if (action === "list") {
+		return {
+			storage: cfgModelRoleStorage.get(settings),
+			items: getKnownRoleIds(settings).map(id => {
+				const info = getRoleInfo(id, settings);
+				const selector = settings.getModelRole(id);
+				const resolved = resolveModelRoleValue(selector, session.modelRegistry.getAvailable("all"), { settings });
+				return {
+					id,
+					name: info.name,
+					section: info.section,
+					hidden: info.hidden,
+					selector,
+					modelId: resolved.model ? `${resolved.model.provider}/${resolved.model.id}` : selector,
+					thinkingLevel: resolved.thinkingLevel,
+					source: settings.getModelRoleSource(id),
+					candidates: roleCandidatePool(id, settings, session.modelRegistry).map(modelView),
+				};
+			}),
+			models: session.modelRegistry.getAvailable("all").map(modelView),
+			presets: getModelPresetNames(settings).map(id => ({
+				id,
+				name: id,
+				source: settings.getOwnedModelPreset(id)?.source,
+				...getModelPreset(settings, id),
+			})),
+			activePreset: findActiveModelPreset(settings),
+		};
+	}
+	if (action === "preset_save" || action === "preset_delete") {
+		const name = text(args, "name");
+		const result = action === "preset_save" ? saveModelPreset(settings, name) : deleteModelPreset(settings, name);
+		await settings.flush();
+		return {
+			message: result === "project" ? "全局预设已清除；另一个配置层仍定义了同名预设" : "模型预设已保存",
+			result,
+		};
+	}
+	if (action === "preset_apply") {
+		const result = await applyModelPreset(settings, session, text(args, "name"));
+		await settings.flush();
+		if (result.kind !== "switched") throw new Error("reason" in result ? result.reason : "找不到模型预设");
+		return {
+			message:
+				result.shadowed.length || result.shadowedThinking
+					? "预设已应用；部分配置受更高优先级来源覆盖"
+					: "模型预设已应用",
+			result,
+		};
+	}
+	if (action !== "set") throw new Error(`未知模型操作：${action}`);
+	const role = text(args, "role");
+	if (!getKnownRoleIds(settings).includes(role)) throw new Error(`未知模型角色：${role}`);
+	const selected = args.modelId === null ? undefined : text(args, "modelId");
+	let selector = selected;
+	if (selected) {
+		const model = roleCandidatePool(role, settings, session.modelRegistry).find(
+			item => `${item.provider}/${item.id}` === selected,
+		);
+		if (!model) throw new Error("该模型不可用于当前角色，请刷新模型列表");
+		if (args.thinkingLevel !== undefined && args.thinkingLevel !== null && args.thinkingLevel !== "inherit") {
+			const raw = text(args, "thinkingLevel");
+			if (parseConfiguredThinkingLevel(raw) === undefined) throw new Error("无效的思考等级");
+			selector = `${selected}:${raw}`;
+		}
+	}
+	const release = await acquireModelRoleMutation();
+	try {
+		if (cfgModelRoleStorage.get(settings) === "project") {
+			if (selector) settings.setProjectModelRole(role, selector);
+			else settings.clearProjectModelRole(role);
+		} else settings.setModelRole(role, selector);
+		await settings.flush();
+	} finally {
+		release();
+	}
+	return {
+		message: "模型角色已保存",
+		role,
+		modelId: settings.getModelRole(role),
+		source: settings.getModelRoleSource(role),
+		restartRequired: role === "default",
+	};
+}
+
+function mcpConfig(value: unknown): MCPServerConfig {
+	if (!isRecord(value)) throw new Error("请填写 MCP 配置");
+	const transport = value.type ?? (value.command ? "stdio" : "http");
+	if (transport === "stdio") {
+		const parsed = stdioInput.assert(value);
+		const result = {
+			type: "stdio" as const,
+			command: parsed.command,
+			args: parsed.args,
+			env: parsed.env,
+			cwd: parsed.cwd,
+		};
+		const errors = validateServerConfig("desktop", result);
+		if (errors.length) throw new Error(errors.join("；"));
+		return result;
+	}
+	if (transport !== "http" && transport !== "sse") throw new Error("MCP 类型必须为 stdio、http 或 sse");
+	const parsed = remoteInput.assert(value);
+	const url = new URL(parsed.url);
+	if (url.protocol !== "http:" && url.protocol !== "https:") throw new Error("MCP 地址必须为 HTTP 或 HTTPS");
+	return { type: transport, url: parsed.url, headers: parsed.headers };
+}
+
+async function manageMcp(
+	session: AgentSession,
+	action: string,
+	args: Record<string, unknown>,
+	options: DesktopManageOptions,
+): Promise<object> {
+	const cwd = session.sessionManager.getCwd();
+	const manager = options.mcpManager;
+	const userPath = getMCPConfigPath("user", cwd);
+	const projectPath = getMCPConfigPath("project", cwd);
+	const writableSource = (item: MCPServer): string | undefined => {
+		const source = item._source;
+		if (source.path === userPath || source.path === projectPath) return source.path;
+		if (source.provider === "mcp-json" && ["mcp.json", ".mcp.json"].includes(path.basename(source.path)))
+			return source.path;
+		if (
+			source.provider === "native" &&
+			path.basename(source.path) === "mcp.json" &&
+			path.basename(path.dirname(source.path)) === ".omp"
+		)
+			return source.path;
+		return undefined;
+	};
+	if (action === "list") {
+		const [loaded, user] = await Promise.all([
+			loadCapability<MCPServer>(mcpCapability.id, {
+				cwd,
+				includeDisabled: true,
+				disabledExtensions: [],
+				extensionRoots: session.effectiveExtensionRoots,
+			}),
+			readMCPConfigFile(userPath),
+		]);
+		const disabled = new Set(user.disabledServers ?? []);
+		const forced = new Set(user.enabledServers ?? []);
+		return {
+			items: loaded.items.map(item => ({
+				id: item.name,
+				name: item.name,
+				type: item.transport ?? (item.command ? "stdio" : "http"),
+				source: item._source.path,
+				scope: item._source.level,
+				readOnly: writableSource(item) === undefined,
+				enabled:
+					!cfgDisabledExtensions.get(session.settings).includes(`mcp:${item.name}`) &&
+					!disabled.has(item.name) &&
+					(forced.has(item.name) || item.enabled !== false),
+				status: manager?.getConnectionStatus(item.name) ?? "disconnected",
+				toolCount: manager?.getConnection(item.name)?.tools?.length ?? 0,
+				projectConfigEnabled: cfgMcpEnableProjectConfig.get(session.settings),
+			})),
+			warnings: loaded.warnings,
+		};
+	}
+	if (action === "cancel_auth") {
+		authFlows.get(session)?.get(text(args, "id"))?.abort("用户取消授权");
+		return { message: "已取消授权" };
+	}
+	if (action === "add") {
+		await addMCPServer(getMCPConfigPath(scopeOf(args), cwd), text(args, "name"), mcpConfig(args.config));
+		resetCapabilities();
+		return { message: "MCP 服务已保存", restartRequired: true };
+	}
+	const name = args.id === undefined && action === "test" ? "desktop-probe" : text(args, "id");
+	const selected = (
+		await loadCapability<MCPServer>(mcpCapability.id, {
+			cwd,
+			includeDisabled: true,
+			disabledExtensions: [],
+			extensionRoots: session.effectiveExtensionRoots,
+		})
+	).items.find(item => item.name === name);
+	const sourcePath = selected ? writableSource(selected) : undefined;
+	let found: FoundMcpServer | null = await findMcpServerForAuth(name, cwd, manager, {
+		enableProjectConfig: cfgMcpEnableProjectConfig.get(session.settings),
+	});
+	if (selected) {
+		const persisted = sourcePath ? (await readMCPConfigFile(sourcePath)).mcpServers?.[name] : undefined;
+		const config =
+			persisted ??
+			manager?.getServerConfig(name) ??
+			({ ...selected, type: selected.transport ?? (selected.command ? "stdio" : "http") } as MCPServerConfig);
+		found = {
+			config,
+			filePath: sourcePath ?? userPath,
+			scope: selected._source.level === "project" ? "project" : "user",
+			discovered: !sourcePath,
+		};
+	}
+	if (action === "test") {
+		const config = args.config === undefined ? found?.config : mcpConfig(args.config);
+		if (!config) throw new Error("找不到 MCP 服务");
+		await probeMcpConnection(config, { authStorage: session.modelRegistry.authStorage, mcpManager: manager, cwd });
+		return { message: "MCP 连接测试成功", ok: true };
+	}
+	if (action === "enable" || action === "disable") {
+		if (!found) throw new Error("找不到 MCP 服务");
+		await setMcpServerEnabled({ userPath, projectPath, sourcePath, name, enabled: action === "enable" });
+		if (action === "enable") {
+			const disabled = cfgDisabledExtensions.get(session.settings);
+			if (disabled.includes(`mcp:${name}`))
+				await setSetting(
+					session,
+					"disabledExtensions",
+					disabled.filter(id => id !== `mcp:${name}`),
+				);
+		}
+		resetCapabilities();
+		if (action === "disable") {
+			await manager?.disconnectServer(name);
+			if (manager) await session.refreshMCPTools(manager.getTools());
+		}
+		return { message: "MCP 配置已保存", restartRequired: action === "enable" };
+	}
+	if (action === "remove") {
+		if (!sourcePath) throw new Error("该服务来自外部配置，可停用或在其来源文件中删除");
+		await removeMCPServer(sourcePath, name);
+		await manager?.disconnectServer(name);
+		if (manager) await session.refreshMCPTools(manager.getTools());
+		resetCapabilities();
+		return { message: "MCP 服务已移除", restartRequired: true };
+	}
+	if (!found) throw new Error("找不到 MCP 服务");
+	if (action === "reconnect") {
+		const status = await reconnectMcpManagerServer(manager, name, found.config);
+		if (manager) await session.refreshMCPTools(manager.getTools());
+		return {
+			message: status === "connected" ? "MCP 已连接" : "MCP 配置将在重启会话后加载",
+			status,
+			restartRequired: status === undefined,
+		};
+	}
+	if (action === "reauth") {
+		let flows = authFlows.get(session);
+		if (!flows) {
+			flows = new Map();
+			authFlows.set(session, flows);
+		}
+		flows.get(name)?.abort("重新开始授权");
+		const controller = new AbortController();
+		flows.set(name, controller);
+		try {
+			const result = await reauthorizeMcpServer(name, found, {
+				authStorage: session.modelRegistry.authStorage,
+				mcpManager: manager,
+				cwd,
+				signal: options.signal ? AbortSignal.any([controller.signal, options.signal]) : controller.signal,
+				onAuth: options.onAuth,
+				flowOwner: session,
+			});
+			await reconnectMcpManagerServer(manager, name, result.config);
+			if (manager) await session.refreshMCPTools(manager.getTools());
+			return { message: "MCP 授权已更新" };
+		} finally {
+			if (flows.get(name) === controller) flows.delete(name);
+		}
+	}
+	throw new Error(`未知 MCP 操作：${action}`);
+}
+
+async function allSkills(session: AgentSession): Promise<Skill[]> {
+	return (
+		await loadSkills({
+			...cfgSkills.get(session.settings),
+			cwd: session.sessionManager.getCwd(),
+			enabled: true,
+			disabledExtensions: [],
+			extensionRoots: session.effectiveExtensionRoots,
+		})
+	).skills;
+}
+
+function skillView(session: AgentSession, skill: Skill): object {
+	return {
+		id: skill.name,
+		name: skill.name,
+		description: skill.description,
+		source: skill.filePath,
+		scope: skill._source?.level,
+		provider: skill._source?.provider,
+		managed: skill._source?.provider === MANAGED_SKILLS_PROVIDER_ID,
+		enabled: !cfgDisabledExtensions.get(session.settings).includes(`skill:${skill.name}`),
+	};
