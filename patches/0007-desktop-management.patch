+
+async function manageSkills(session: AgentSession, action: string, args: Record<string, unknown>): Promise<object> {
+	if (action === "list") return { items: (await allSkills(session)).map(skill => skillView(session, skill)) };
+	if (action === "create" || action === "update" || action === "delete") {
+		const name = action === "delete" ? text(args, "id") : text(args, "name");
+		if (
+			action !== "create" &&
+			!(await allSkills(session)).some(
+				skill => skill.name === name && skill._source?.provider === MANAGED_SKILLS_PROVIDER_ID,
+			)
+		)
+			throw new Error("只可修改 OMP 托管技能");
+		const result = await new ManageSkillTool(() => session.refreshSkills()).execute(
+			"desktop",
+			action === "delete"
+				? { action, name }
+				: { action, name, description: text(args, "description"), body: text(args, "body", true) },
+		);
+		if (result.isError)
+			throw new Error(
+				result.content
+					.filter(item => item.type === "text")
+					.map(item => ("text" in item ? item.text : ""))
+					.join("\n"),
+			);
+		return { message: action === "delete" ? "托管技能已删除" : "托管技能已保存" };
+	}
+	const id = text(args, "id");
+	const skill = (await allSkills(session)).find(item => item.name === id);
+	if (!skill) throw new Error("找不到技能");
+	if (action === "detail") return { item: { ...skillView(session, skill), body: await loadSkillPromptBody(skill) } };
+	if (action === "enable" || action === "disable") {
+		const key = `skill:${id}`;
+		const disabled = new Set(cfgDisabledExtensions.get(session.settings));
+		if (action === "enable") disabled.delete(key);
+		else disabled.add(key);
+		await setSetting(session, "disabledExtensions", [...disabled]);
+		await session.refreshSkillsAndCommands();
+		return { message: "技能状态已保存" };
+	}
+	throw new Error(`未知技能操作：${action}`);
+}
