+async function managePlugins(
+	session: AgentSession,
+	action: string,
+	args: Record<string, unknown>,
+	options: DesktopManageOptions,
+): Promise<object> {
+	const npm = new PluginManager(session.sessionManager.getCwd());
+	const marketplace = await marketplaceManager(session);
+	const [packages, installed] = await Promise.all([npm.list(), marketplace.listInstalledPlugins()]);
+	const marketplacePaths = new Set(
+		installed.flatMap(item => item.entries.map(entry => path.resolve(entry.installPath))),
+	);
+	if (action === "list")
+		return {
+			items: [
+				...installed.map(item => ({
+					id: item.id,
+					name: item.id,
+					scope: item.scope,
+					source: item.entries[0]?.installPath,
+					version: item.entries[0]?.version,
+					enabled: item.entries[0]?.enabled !== false,
+					shadowedBy: item.shadowedBy,
+				})),
+				...packages
+					.filter(item => !marketplacePaths.has(path.resolve(item.path)))
+					.map(item => ({
+						id: item.name,
+						name: item.manifest.name ?? item.name,
+						description: item.manifest.description,
+						source: item.path,
+						scope: "user",
+						enabled: item.enabled,
+						version: item.version,
+					})),
+			],
+		};
+	if (action === "install") {
+		const source = text(args, "source");
+		const parsed = parsePluginId(source);
+		const registered =
+			parsed && (await marketplace.listMarketplaces()).some(item => item.name === parsed.marketplace);
+		if (parsed && registered) {
+			if (!installed.some(item => item.id === source && item.scope === scopeOf(args)))
+				await marketplace.installPlugin(parsed.name, parsed.marketplace, { scope: scopeOf(args) });
+		} else {
+			if (scopeOf(args) === "project") throw new Error("npm 和本地插件安装到用户作用域；项目作用域可安装市场插件");
+			const localPath = path.resolve(
+				session.sessionManager.getCwd(),
+				expandTilde(source.startsWith("file:") ? source.slice(5) : source),
+			);
+			const localDirectory =
+				!parseGitUrl(source) &&
+				!source.startsWith("npm:") &&
+				(await fs.stat(localPath).then(
+					info => info.isDirectory(),
+					error => {
+						if (isEnoent(error) || error.code === "ENOTDIR") return false;
+						throw error;
+					},
+				));
+			if (localDirectory) {
+				const target = await fs.realpath(localPath);
+				const existingPaths = await Promise.all(packages.map(item => fs.realpath(item.path)));
+				if (!existingPaths.includes(target)) await npm.link(localPath);
+			} else await npm.install(source);
+		}
+		clearPluginRootsAndCaches();
+		await options.reloadPlugins?.();
+		return { message: "插件已安装", restartRequired: true };
+	}
+	const id = text(args, "id");
+	const marketEntry = installed.find(
+		item => item.id === id && (args.scope === undefined || item.scope === scopeOf(args)),
+	);
+	let plugin: InstalledPlugin | undefined = packages.find(item => item.name === id);
+	if (marketEntry) {
+		const directory = marketEntry.entries[0]?.installPath;
+		if (directory) {
+			let packageName = parsePluginId(id)?.name ?? id;
+			try {
+				const manifest = await Bun.file(path.join(directory, "package.json")).json();
+				if (typeof manifest.name === "string") packageName = manifest.name;
+			} catch (error) {
+				if (!isEnoent(error)) throw error;
+			}
+			plugin = await npm.getPlugin(packageName, { path: directory });
+		}
+	}
+	if (action === "enable" || action === "disable") {
+		if (marketEntry)
+			await marketplace.setPluginEnabled(id, action === "enable", scopeOf({ scope: marketEntry.scope }));
+		else if (plugin) await npm.setEnabled(plugin.name, action === "enable");
+		else throw new Error("找不到插件");
+	} else if (action === "update" || action === "remove") {
+		if (marketEntry) {
+			if (action === "update") await marketplace.upgradePlugin(id, marketEntry.scope);
+			else await marketplace.uninstallPlugin(id, marketEntry.scope);
+		} else if (plugin) {
+			if (action === "update") await npm.upgrade(plugin.name);
+			else await npm.uninstall(plugin.name);
+		} else throw new Error("找不到插件");
+	} else {
+		if (!plugin) throw new Error("该插件未提供可编辑的 OMP 配置清单");
+		const schemas = plugin.manifest.settings ?? {};
+		const projectRegistry =
+			marketEntry?.scope === "project"
+				? await resolveOrDefaultProjectRegistryPath(session.sessionManager.getCwd())
+				: undefined;
+		if (marketEntry?.scope === "project" && !projectRegistry) throw new Error("找不到项目插件存储位置");
+		const runtimeFile = projectRegistry
+			? path.join(path.dirname(projectRegistry), "omp-plugins.lock.json")
+			: getPluginsLockfile();
+		const loadRuntime = async () => {
+			try {
+				return normalizePluginRuntimeConfig(await Bun.file(runtimeFile).json());
+			} catch (error) {
+				if (!isEnoent(error)) throw error;
+				return normalizePluginRuntimeConfig({});
+			}
+		};
+		if (action === "detail") {
+			const runtime = await loadRuntime();
+			const values = projectRegistry
+				? (runtime.settings[plugin.name] ?? {})
+				: await npm.getPluginSettings(plugin.name);
+			const features = plugin.manifest.features ?? {};
+			return {
+				item: {
+					id,
+					name: plugin.manifest.name ?? plugin.name,
+					source: plugin.path,
+					description: plugin.manifest.description,
+					scope: marketEntry?.scope ?? "user",
+					features: Object.keys(features),
+					enabledFeatures:
+						runtime.plugins[plugin.name]?.enabledFeatures ??
+						Object.keys(features).filter(key => features[key].default),
+					schema: {
+						type: "object",
+						properties: Object.fromEntries(
+							Object.entries(schemas).map(([key, schema]) => [
+								key,
+								{
+									...schema,
+									type: schema.type === "enum" ? "string" : schema.type,
+									enum: schema.type === "enum" ? schema.values : undefined,
+									minimum: schema.type === "number" ? schema.min : undefined,
+									maximum: schema.type === "number" ? schema.max : undefined,
+								},
+							]),
+						),
+					},
+					settings: Object.fromEntries(Object.entries(values).filter(([key]) => !schemas[key]?.secret)),
+					configured: Object.fromEntries(
+						Object.entries(schemas)
+							.filter(([, schema]) => schema.secret)
+							.map(([key]) => [key, values[key] !== undefined]),
+					),
+				},
+			};
+		}
+		if (action === "features") {
+			const features = type("string[]").assert(args.features);
+			if (features.some(key => !Object.hasOwn(plugin.manifest.features ?? {}, key))) throw new Error("未知插件功能");
+			if (!projectRegistry) await npm.setEnabledFeatures(plugin.name, features);
+			else
+				await withFileLock(runtimeFile, async () => {
+					const runtime = await loadRuntime();
+					if (!runtime.plugins[plugin.name]) throw new Error("项目插件安装尚未完成，请重新安装");
+					runtime.plugins[plugin.name].enabledFeatures = features;
+					await writePluginRuntimeConfig(runtimeFile, runtime);
+				});
+		} else if (action === "setting" || action === "reset") {
+			const key = text(args, "key");
+			const schema = schemas[key];
+			if (!schema) throw new Error("未知插件配置字段");
+			if (action === "setting") {
+				if (!Object.hasOwn(args, "value")) throw new Error("请填写配置值");
+				const validation = validateSetting(args.value, schema);
+				if (!validation.valid) throw new Error(validation.error);
+			}
+			if (!projectRegistry) {
+				if (action === "reset") await npm.deletePluginSetting(plugin.name, key);
+				else await npm.setPluginSetting(plugin.name, key, args.value);
+			} else
+				await withFileLock(runtimeFile, async () => {
+					const runtime = await loadRuntime();
+					const values = runtime.settings[plugin.name] ?? {};
+					if (action === "reset") delete values[key];
+					else values[key] = args.value;
+					runtime.settings[plugin.name] = values;
+					await writePluginRuntimeConfig(runtimeFile, runtime);
+				});
+		} else throw new Error(`未知插件操作：${action}`);
+	}
+	clearPluginRootsAndCaches();
+	await options.reloadPlugins?.();
+	return { message: "插件配置已保存", restartRequired: true };
+}
+
+async function manageMarketplaces(
+	session: AgentSession,
+	action: string,
+	args: Record<string, unknown>,
+): Promise<object> {
+	const manager = await marketplaceManager(session);
+	if (action === "list")
+		return {
+			items: (await manager.listMarketplaces()).map(item => ({ ...item, id: item.name, source: item.sourceUri })),
+		};
+	if (action === "list_available") {
+		const id = text(args, "id");
+		return {
+			items: (await manager.listAvailablePlugins(id)).map(item => ({
+				...item,
+				id: `${item.name}@${id}`,
+				source: `${item.name}@${id}`,
+			})),
+		};
+	}
+	if (action === "add") {
+		const source = text(args, "source");
+		if (!(await manager.listMarketplaces()).some(item => item.sourceUri === source))
+			await manager.addMarketplace(source);
+	} else if (action === "remove") await manager.removeMarketplace(text(args, "id"));
+	else if (action === "refresh") await manager.updateMarketplace(text(args, "id"));
+	else throw new Error(`未知市场操作：${action}`);
+	return { message: "插件市场已更新" };
+}
+
+async function manageAgents(session: AgentSession, action: string, args: Record<string, unknown>): Promise<object> {
+	const result = await discoverAgents(session.sessionManager.getCwd(), undefined, session.effectiveExtensionRoots);
+	const disabled = type("string[]").assert(configured(session, "task.disabledAgents"));
+	const models = configured(session, "task.agentModelOverrides");
+	const prewalk = configured(session, "task.agentPrewalk");
+	if (action === "list")
+		return {
+			items: result.agents.map(item => ({
+				...item,
+				id: item.name,
+				model: item.model?.join(", "),
+				source: item.filePath ?? item.source,
+				scope: item.source,
+				enabled: !disabled.includes(item.name),
+				modelOverride: isRecord(models) ? models[item.name] : undefined,
+				prewalkOverride: isRecord(prewalk) ? prewalk[item.name] : "default",
+			})),
+		};
+	const id = text(args, "id");
+	if (!result.agents.some(item => item.name === id)) throw new Error("找不到 Agent 定义");
+	if (action === "enable" || action === "disable") {
+		await setSetting(
+			session,
+			"task.disabledAgents",
+			action === "enable" ? disabled.filter(item => item !== id) : [...new Set([...disabled, id])],
+		);
+	} else if (action === "model") {
+		const overrides = isRecord(models) ? { ...models } : {};
+		const model = text(args, "model", true).trim();
+		if (model) overrides[id] = model;
+		else delete overrides[id];
+		await setSetting(session, "task.agentModelOverrides", overrides);
+	} else if (action === "prewalk") {
+		const value = text(args, "value");
+		if (value !== "default" && value !== "on" && value !== "off") throw new Error("无效的 Prewalk 选项");
+		const overrides = isRecord(prewalk) ? { ...prewalk } : {};
+		if (value === "default") delete overrides[id];
+		else overrides[id] = value;
+		await setSetting(session, "task.agentPrewalk", overrides);
+	} else throw new Error(`未知 Agent 操作：${action}`);
+	return { message: "Agent 配置已保存；后续任务将使用新配置" };
+}
+
+async function manageSsh(session: AgentSession, action: string, args: Record<string, unknown>): Promise<object> {
+	const cwd = session.sessionManager.getCwd();
+	if (action === "list") {
+		const items: object[] = [];
+		const names = new Set<string>();
+		for (const scope of ["project", "user"] as const) {
+			const file = getSSHConfigPath(scope, cwd);
+			const config = await readSSHConfigFile(file);
+			for (const [name, host] of Object.entries(config.hosts ?? {})) {
+				items.push({ ...host, id: name, name, scope, source: file });
+				names.add(name);
+			}
+		}
+		const discovered = await loadCapability<SSHHost>("ssh", { cwd, extensionRoots: session.effectiveExtensionRoots });
+		items.push(
+			...discovered.items
+				.filter(item => !names.has(item.name))
+				.map(item => ({ ...item, id: item.name, scope: "native", source: item._source.path, readOnly: true })),
+		);
+		return { items, warnings: discovered.warnings };
+	}
+	if (action === "test") {
+		const id = args.id === undefined ? "desktop-test" : text(args, "id");
+		const found =
+			args.host === undefined
+				? args.scope === "user" || args.scope === "project"
+					? (await readSSHConfigFile(getSSHConfigPath(scopeOf(args), cwd))).hosts?.[id]
+					: (await loadCapability<SSHHost>("ssh", { cwd })).items.find(item => item.name === id)
+				: undefined;
+		const host = sshInput.assert(args.host ?? found);
+		if (!host.host.trim() || (host.port !== undefined && (host.port < 1 || host.port > 65535)))
+			throw new Error("请检查 SSH 地址和端口");
+		await ensureConnection({ ...host, name: id });
+		return { message: "SSH 连接测试成功", ok: true, info: await getHostInfoForHost({ ...host, name: id }) };
+	}
+	const scope = scopeOf(args);
+	const file = getSSHConfigPath(scope, cwd);
+	const name = action === "delete" ? text(args, "id") : text(args, "name");
+	const error = validateHostName(name);
+	if (error) throw new Error(error);
+	await fs.mkdir(path.dirname(file), { recursive: true });
+	if (action === "delete") {
+		await withFileLock(file, async () => {
+			const config = await readSSHConfigFile(file);
+			if (config.hosts?.[name]) {
+				delete config.hosts[name];
+				await writeSSHConfigFile(file, config);
+			}
+		});
+	} else if (action === "create" || action === "update") {
+		const host = sshInput.assert(args.host);
+		if (!host.host.trim() || (host.port !== undefined && (host.port < 1 || host.port > 65535)))
+			throw new Error("请检查 SSH 地址和端口");
+		const previousName = typeof args.previousName === "string" ? args.previousName : name;
+		const previousScope = args.previousScope === undefined ? scope : scopeOf({ scope: args.previousScope });
+		const previousFile = getSSHConfigPath(previousScope, cwd);
+		await withFileLock(file, async () => {
+			const config = await readSSHConfigFile(file);
+			const existing = config.hosts?.[name];
+			if (
+				existing &&
+				(action === "create" || name !== previousName || file !== previousFile) &&
+				!isDeepStrictEqual(existing, host)
+			)
+				throw new Error("同名 SSH 主机已存在");
+			config.hosts = { ...config.hosts, [name]: host };
+			if (file === previousFile && name !== previousName) delete config.hosts[previousName];
+			await writeSSHConfigFile(file, config);
+		});
+		// 跨作用域先提交新文件；中断后可重试，再清理旧条目。
+		if (action === "update" && previousFile !== file) {
+			await fs.mkdir(path.dirname(previousFile), { recursive: true });
+			await withFileLock(previousFile, async () => {
+				const config = await readSSHConfigFile(previousFile);
+				if (config.hosts?.[previousName]) {
+					delete config.hosts[previousName];
+					await writeSSHConfigFile(previousFile, config);
+				}
+			});
+		}
+	} else throw new Error(`未知 SSH 操作：${action}`);
+	resetCapabilities();
+	await invalidateHostMetadata([name, ...(typeof args.previousName === "string" ? [args.previousName] : [])]);
+	return { message: "SSH 主机配置已保存" };
+}
+
+async function manageResources(session: AgentSession, action: string, args: Record<string, unknown>): Promise<object> {
+	const kind = text(args, "kind");
+	const cwd = session.sessionManager.getCwd();
+	let items: Array<Record<string, unknown>>;
+	if (kind === "hooks") {
+		const result = await loadCapability<Hook>("hooks", {
+			cwd,
+			includeDisabled: true,
+			extensionRoots: session.effectiveExtensionRoots,
+		});
+		const disabled = cfgDisabledExtensions.get(session.settings);
+		items = result.items.map(item => ({
+			id: `hook:${item.type}:${item.tool}:${item.name}`,
+			name: item.name,
+			source: item.path,
+			scope: item.level,
+			description: `${item.type} · ${item.tool}`,
+			enabled: !disabled.includes(`hook:${item.type}:${item.tool}:${item.name}`),
+		}));
+		if (action === "enable" || action === "disable") {
+			const id = text(args, "id");
+			if (!items.some(item => item.id === id)) throw new Error("找不到 Hook");
+			const next = new Set(disabled);
+			if (action === "enable") next.delete(id);
+			else next.add(id);
+			await setSetting(session, "disabledExtensions", [...next]);
+			return { message: "Hook 状态已保存", restartRequired: true };
+		}
+	} else if (kind === "commands") {
+		items = (await buildAvailableSlashCommands(session)).map(item => ({
+			...item,
+			id: item.name,
+			content: JSON.stringify(item, null, 2),
+		}));
+	} else if (kind === "templates") {
+		items = session.promptTemplates.map(item => ({ ...item, id: item.name }));
+	} else if (kind === "memory") {
+		const backend = await resolveMemoryBackend(session.settings);
+		const context = { agentDir: getAgentDir(), cwd, session };
+		const status = await backend.status?.(context);
+		items = [
+			{
+				id: backend.id,
+				name: backend.id,
+				description: status?.message,
+				source: status?.database ?? cwd,
+				content: JSON.stringify(status ?? { backend: backend.id }, null, 2),
+				...status,
+			},
+		];
+		if (backend.id === "local") {
+			const root = getMemoryRoot(context.agentDir, cwd);
+			for (const filename of ["MEMORY.md", "memory_summary.md", "learned.md"]) {
+				const file = path.join(root, filename);
+				try {
+					items.push({ id: filename, name: filename, source: file, content: await Bun.file(file).text() });
+				} catch (error) {
+					if (!isEnoent(error)) throw error;
+				}
+			}
+		}
+	} else throw new Error(`未知资源类型：${kind}`);
+	if (action === "list") return { items };
+	if (action === "detail") {
+		const item = items.find(item => item.id === text(args, "id"));
+		if (!item) throw new Error("找不到资源");
+		if (kind === "hooks" && typeof item.source === "string")
+			return { item: { ...item, content: await Bun.file(item.source).text() } };
+		return { item };
+	}
+	throw new Error(`未知资源操作：${action}`);
+}
