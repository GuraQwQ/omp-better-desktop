diff --git a/packages/coding-agent/test/rpc-btw-images.test.ts b/packages/coding-agent/test/rpc-btw-images.test.ts
new file mode 100644
index 0000000..3702bcb
--- /dev/null
+++ b/packages/coding-agent/test/rpc-btw-images.test.ts
@@ -0,0 +1,50 @@
+import { expect, test } from "bun:test";
+import type { AssistantMessage, ImageContent } from "@oh-my-pi/pi-ai";
+import { RpcBtwController } from "../src/modes/rpc/rpc-btw";
+
+test("RPC旁问图像进入临时回合并随原生主题追问回放", async () => {
+	type Session = ConstructorParameters<typeof RpcBtwController>[0];
+	type TurnArgs = Parameters<Session["runEphemeralTurn"]>[0];
+	const calls: TurnArgs[] = [];
+	let terminal = Promise.withResolvers<void>();
+	const session: Session = {
+		model: { id: "test-model", api: "anthropic-messages", provider: "anthropic" } as Session["model"],
+		sessionManager: {
+			getSessionId: () => "btw-images",
+			getArtifactsDir: () => undefined,
+			getLeafId: () => null,
+			ensureOnDisk: async () => {},
+		} as unknown as Session["sessionManager"],
+		runEphemeralTurn: async args => {
+			calls.push(args);
+			return { replyText: "图像已接收", assistantMessage: {} as AssistantMessage };
+		},
+	};
+	const controller = new RpcBtwController(session, frame => {
+		if (frame.type === "btw_record" && (frame.record.followUps?.at(-1) ?? frame.record).status === "complete") {
+			terminal.resolve();
+		}
+	});
+	const firstImage: ImageContent = { type: "image", mimeType: "image/png", data: "iVBORw0KGgo=" };
+	const secondImage: ImageContent = { type: "image", mimeType: "image/jpeg", data: "/9j/2Q==" };
+	try {
+		const first = await controller.ask("识别第一张图", undefined, [firstImage]);
+		await terminal.promise;
+		expect(first.images).toEqual([firstImage]);
+		expect(calls[0]!.promptImages).toEqual([firstImage]);
+		expect(calls[0]!.promptText).not.toContain(firstImage.data);
+		terminal = Promise.withResolvers<void>();
+		const second = await controller.ask("比较第二张图", first.id, [secondImage]);
+		await terminal.promise;
+		expect(second.id).toBe(first.id);
+		expect(second.followUps?.[0]?.images).toEqual([secondImage]);
+		expect(calls[1]!.promptImages).toEqual([secondImage]);
+		expect(calls[1]!.history?.[0]?.content).toContainEqual(firstImage);
+		expect(calls[1]!.conversationKey).toBe(calls[0]!.conversationKey);
+		const history = await controller.history();
+		expect(history).toHaveLength(1);
+		expect(history[0]!.followUps?.[0]?.status).toBe("complete");
+	} finally {
+		await controller.close();
+	}
+});
