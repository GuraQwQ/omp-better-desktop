+/** 执行与工具说明共用同一配置解析，不根据操作系统推测命令语言。 */
+export function resolveBashShellRouting(settings: Settings, useUserShell = false) {
+	const baseShellConfig = settings.getShellConfig();
+	const shellConfig = useUserShell ? resolveUserShellConfig(settings, baseShellConfig) : baseShellConfig;
+	const bashShell = isBashShell(shellConfig.shell);
+	return {
+		shellConfig,
+		bashShell,
+		wrapUserCommand: useUserShell && !bashShell && !isCmdShell(shellConfig.shell),
+	};
+}
+
+/** 描述解析失败不影响纯读取会话；真正执行时仍沿用原配置错误。 */
+export function describeBashShellRouting(settings: Settings): string {
+	const ordinary = "Local non-PTY commands use embedded Bash (pi-shell).";
+	try {
+		const { shellConfig } = resolveBashShellRouting(settings);
+		const shell = shellConfig.shell;
+		const syntax = isPowerShell(shell)
+			? "PowerShell"
+			: isCmdShell(shell)
+				? "cmd"
+				: isPosixShell(shell)
+					? "POSIX"
+					: shellBasename(shell).includes("fish")
+						? "fish"
+						: "shell-specific";
+		return `${ordinary} PTY and ACP client terminals use ${JSON.stringify(shell)} (${syntax} syntax).`;
+	} catch {
+		return `${ordinary} External PTY/ACP shell: unresolved; check shellPath.`;
+	}
+}
