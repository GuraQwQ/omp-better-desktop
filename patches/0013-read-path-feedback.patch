--- /dev/null
+++ b/packages/coding-agent/src/session/read-path-feedback.ts
@@ -0,0 +1,52 @@
+import type { DeveloperMessage, Message } from "@oh-my-pi/pi-ai";
+import { markPerCallContextMessage } from "@oh-my-pi/pi-ai/utils/block-symbols";
+
+interface ReadPathResolution {
+	requested: string;
+	resolved: string;
+}
+
+/** 只在发给模型的上下文补充路径；原始工具结果和程序化读取保持原样。 */
+export function withReadPathFeedback(messages: Message[], enabled: boolean): Message[] {
+	if (!enabled) return messages;
+	const latestPaths = new Map<string, string>();
+	let output: Message[] | undefined;
+	let batch: ReadPathResolution[] = [];
+	for (let index = 0; index < messages.length; index++) {
+		const message = messages[index];
+		output?.push(message);
+		if (message.role !== "toolResult") continue;
+		if (message.toolName === "read" && !message.isError) {
+			const details = message.details as
+				| { raw?: unknown; suffixResolution?: { from?: unknown; to?: unknown; raw?: unknown } }
+				| undefined;
+			const resolution = details?.suffixResolution;
+			if (
+				typeof resolution?.from === "string" &&
+				typeof resolution.to === "string" &&
+				resolution.from.length > 0 &&
+				resolution.to.length > 0 &&
+				resolution.from !== resolution.to
+			) {
+				const changed = latestPaths.get(resolution.from) !== resolution.to;
+				latestPaths.set(resolution.from, resolution.to);
+				if (changed && (details?.raw === true || resolution.raw === true)) {
+					batch.push({ requested: resolution.from, resolved: resolution.to });
+				}
+			}
+		}
+		// 整批工具结果保持相邻，避免在并行调用的配对中间插入消息。
+		if (messages[index + 1]?.role === "toolResult" || batch.length === 0) continue;
+		const notice: DeveloperMessage = {
+			role: "developer",
+			content: `Read path resolutions (use resolved paths in commands):\n${JSON.stringify(batch)}`,
+			attribution: "agent",
+			timestamp: message.timestamp,
+		};
+		markPerCallContextMessage(notice);
+		output ??= messages.slice(0, index + 1);
+		output.push(notice);
+		batch = [];
+	}
+	return output ?? messages;
+}
