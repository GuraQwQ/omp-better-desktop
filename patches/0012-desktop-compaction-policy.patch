+/** 仅明确拒绝压缩能力时改用模型摘要，服务故障仍沿原请求重试。 */
+export function isNativeCompactionUnsupported(error: unknown): boolean {
+	const cause = error instanceof NativeCompactionError ? error.cause : error;
+	const id = AIError.classify(cause);
+	const status = AIError.status(cause);
+	if ([
+		AIError.Flag.AuthFailed, AIError.Flag.Timeout, AIError.Flag.UsageLimit,
+		AIError.Flag.ContextOverflow, AIError.Flag.Abort,
+	].some(flag => AIError.is(id, flag))) return false;
+	if (status !== 501 && AIError.is(id, AIError.Flag.Transient)) return false;
+	if (status !== undefined && ![400, 404, 405, 422, 501].includes(status)) return false;
+	if (status === 405 || status === 501) return true;
+	const seen = new Set<object>();
+	let current: unknown = typeof cause === "string" ? new Error(cause) : cause;
+	while (current !== null && typeof current === "object" && !seen.has(current)) {
+		seen.add(current);
+		const failure = current as { message?: unknown; code?: unknown; cause?: unknown; captured?: { bodyText?: unknown } };
+		for (const value of [failure.message, failure.code, failure.captured?.bodyText]) {
+			if (typeof value !== "string") continue;
+			const text = value.replace(/[_-]/g, " ");
+			if (/\b(?:compaction|context management)\s+(?:is |are )?(?:not (?:supported|available|enabled|implemented)|unsupported)\b/i.test(text) ||
+				/\b(?:unsupported|unrecognized|does not support|doesn't support|cannot post).{0,100}\b(?:compaction|context management|responses\/compact)\b|responses\/compact.{0,80}\bnot found\b/i.test(text)) return true;
+		}
+		current = failure.cause;
+	}
+	return false;
+}
