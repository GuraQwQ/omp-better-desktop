+/** 恢复旧会话的产物链接，原文件保留到新的会话记录写入后也可继续核对。 */
+export async function migrateLegacyArtifactLinks(
+	entries: readonly object[],
+	source: string,
+	localRoot: string,
+): Promise<boolean> {
+	const files = await fs.readdir(source, { withFileTypes: true }).catch(error => {
+		if (!isEnoent(error)) logger.warn("Failed to scan legacy session artifacts", { source, error: toError(error).message });
+		return [];
+	});
+	const legacy = new Map<string, string>();
+	for (const file of files) {
+		if (!file.isFile()) continue;
+		const id = /^(\d+)\.[A-Za-z0-9_-]+\.log$/.exec(file.name)?.[1];
+		if (id !== undefined && !legacy.has(id)) legacy.set(id, file.name);
+	}
+	if (legacy.size === 0) return false;
+
+	const pattern = /\bartifact:\/\/(\d+)(?![\w/])/g;
+	const ids = new Set<string>();
+	const fields: { record: Record<string, unknown>; key: string; text: string }[] = [];
+	function collect(value: unknown): void {
+		if (typeof value !== "object" || value === null) return;
+		const record = value as Record<string, unknown>;
+		if (record.role === "user") return;
+		for (const [key, item] of Object.entries(record)) {
+			if (typeof item === "string") {
+				let referenced = false;
+				for (const match of item.matchAll(pattern)) {
+					if (!legacy.has(match[1])) continue;
+					ids.add(match[1]);
+					referenced = true;
+				}
+				if (referenced) fields.push({ record, key, text: item });
+			} else collect(item);
+		}
+	}
+	for (const entry of entries) collect(entry);
+
+	const links = new Map<string, string>();
+	for (const id of ids) {
+		const name = legacy.get(id)!;
+		try {
+			const content = await fs.readFile(path.join(source, name), "utf8");
+			const hash = createHash("sha256").update(content).digest("hex").slice(0, 16);
+			const leaf = ["legacy", id, hash].join("-") + ".log";
+			const target = path.join(localRoot, leaf);
+			const previous = await fs.readFile(target, "utf8").catch(error => {
+				if (!isEnoent(error)) throw error;
+				return undefined;
+			});
+			if (previous === undefined) {
+				await fs.mkdir(localRoot, { recursive: true });
+				await writeArtifact(target, content);
+			}
+			if ((previous ?? await fs.readFile(target, "utf8")) === content) links.set(id, "local://" + leaf);
+		} catch (error) {
+			logger.warn("Failed to migrate legacy session artifact", { source, name, error: toError(error).message });
+		}
+	}
+	if (links.size === 0) return false;
+	for (const { record, key, text } of fields) {
+		record[key] = text.replace(pattern, (uri, id) => links.get(id) ?? uri);
+	}
+	return true;
+}
