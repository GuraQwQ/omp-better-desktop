diff --git a/packages/coding-agent/src/session/thinkflow.ts b/packages/coding-agent/src/session/thinkflow.ts
new file mode 100644
index 0000000000000000000000000000000000000000..53279d060f70f7b160c6e9e3629e261b81e8264e
--- /dev/null
+++ b/packages/coding-agent/src/session/thinkflow.ts
@@ -0,0 +1,240 @@
+import fs from "node:fs/promises";
+import path from "node:path";
+import { createHash, randomUUID } from "node:crypto";
+import type {
+	AgentMessage,
+	AgentToolResult,
+	ThinkFlowCommand,
+	ThinkFlowHost,
+	ThinkFlowReceipt,
+	ThinkFlowStatus,
+} from "@oh-my-pi/pi-agent-core";
+import type { SessionManager } from "./session-manager";
+import { resolveToCwd } from "../tools/path-utils";
+import { unwrapHashlineHeaderPath } from "../tools/hashline-header-path";
+
+const digest = (bytes: Uint8Array | string) => createHash("sha256").update(bytes).digest("hex");
+const canonical = (value: unknown): string =>
+	value !== null && typeof value === "object"
+		? Array.isArray(value)
+			? `[${value.map(canonical).join(",")}]`
+			: `{${Object.keys(value)
+					.sort()
+					.map(key => `${JSON.stringify(key)}:${canonical(Reflect.get(value, key))}`)
+					.join(",")}}`
+		: JSON.stringify(value);
+const fingerprint = (command: ThinkFlowCommand) =>
+	digest(canonical({ tool: command.tool, args: command.args, needResult: command.needResult }));
+const resultText = (result: AgentToolResult<unknown>) =>
+	result.content
+		.filter(block => block.type === "text")
+		.map(block => block.text)
+		.join("\n");
+const failed = (result: AgentToolResult<unknown>) =>
+	result.isError === true ||
+	(result.details !== null && typeof result.details === "object" && Reflect.get(result.details, "isError") === true);
+
+/** 会话 JSONL 是唯一权威；悬空意图恢复为 unknown，不重新执行未知副作用。 */
+export class ThinkFlowJournal implements ThinkFlowHost {
+	private sessionId = "";
+	private readonly records = new Map<string, ThinkFlowReceipt>();
+	private readonly baselines = new Map<string, string>();
+	private readonly pending = new Map<string, ThinkFlowReceipt>();
+	constructor(private readonly manager: SessionManager) {}
+	private async save(type: "intent" | "receipt", receipt: ThinkFlowReceipt) {
+		await this.manager.ensureOnDisk();
+		this.manager.appendCustomEntry(`thinkflow.${type}`, receipt);
+		await this.manager.flush();
+		this.records.set(receipt.id, receipt);
+	}
+	async restore(): Promise<ThinkFlowReceipt[]> {
+		const id = this.manager.getSessionId();
+		if (id === this.sessionId) return [];
+		this.sessionId = id;
+		this.records.clear();
+		this.baselines.clear();
+		this.pending.clear();
+		const displayed = new Set<string>();
+		for (const entry of this.manager.getEntries()) {
+			if (entry.type === "custom" && ["thinkflow.intent", "thinkflow.receipt"].includes(entry.customType)) {
+				const receipt = entry.data as ThinkFlowReceipt;
+				if (
+					!receipt ||
+					receipt.schemaVersion !== 1 ||
+					typeof receipt.id !== "string" ||
+					typeof receipt.fingerprint !== "string"
+				)
+					throw Error("ThinkFlow 会话记录格式无法读取，请保留会话后核对。");
+				this.records.set(receipt.id, receipt);
+			} else if (
+				entry.type === "message" &&
+				entry.message.role === "custom" &&
+				entry.message.customType === "thinkflow-observation"
+			) {
+				const details = entry.message.details as { thinkflow?: { receipts?: ThinkFlowReceipt[] } } | undefined;
+				for (const receipt of details?.thinkflow?.receipts ?? []) displayed.add(`${receipt.id}:${receipt.status}`);
+			}
+		}
+		const recovered: ThinkFlowReceipt[] = [];
+		for (const record of this.records.values()) {
+			let receipt = record;
+			if (record.status === "running") {
+				receipt = {
+					...record,
+					status: "unknown",
+					completedAt: Date.now(),
+					error: "上次执行中断且没有持久完成回执；先核对实际文件或进程效果，不自动重放此 id。",
+				};
+				await this.save("receipt", receipt);
+			}
+			if (!displayed.has(`${receipt.id}:${receipt.status}`)) recovered.push(receipt);
+		}
+		return recovered;
+	}
+	private base(command: ThinkFlowCommand): ThinkFlowReceipt {
+		return {
+			schemaVersion: 1,
+			id: command.id,
+			tool: command.tool,
+			args: command.args,
+			fingerprint: fingerprint(command),
+			flow: command.tool === "write" && !command.needResult ? "delayed" : "feedback",
+			status: "running",
+			startedAt: Date.now(),
+			source: command.source,
+		};
+	}
+	async lookup(command: ThinkFlowCommand) {
+		await this.restore();
+		const previous = this.records.get(command.id);
+		if (!previous) return;
+		if (previous.fingerprint !== fingerprint(command))
+			return {
+				...this.base(command),
+				id: `protocol-${randomUUID()}`,
+				tool: "protocol",
+				args: { commandId: command.id },
+				source: undefined,
+				status: "error" as const,
+				flow: "feedback" as const,
+				completedAt: Date.now(),
+				error: `命令 ${command.id} 已被不同参数使用，未执行；原执行回执保持不变，请核对后为新动作使用新 id。`,
+			};
+		if (previous.status === "running")
+			return {
+				...previous,
+				status: "unknown" as const,
+				flow: "feedback" as const,
+				error: "命令已开始但没有确定回执；先核对实际效果，不自动重放。",
+			};
+		return previous;
+	}
+	private localFile(input: unknown): string {
+		if (typeof input !== "string" || !input.trim()) throw Error("ThinkFlow 文件路径不能为空。");
+		if (
+			/^[a-z][a-z0-9+.-]*:\/\//i.test(input) ||
+			input.includes("!/") ||
+			input.includes("::") ||
+			/:/.test(input.replace(/^[a-z]:[\\/]/i, ""))
+		)
+			throw Error("ThinkFlow 文件命令只接受普通本地文件；虚拟 URI、档案成员及选择器请使用原生工具。");
+		return resolveToCwd(unwrapHashlineHeaderPath(input), this.manager.getCwd());
+	}
+	private async version(file: string) {
+		try {
+			const stat = await fs.lstat(file);
+			if (!stat.isFile() || stat.isSymbolicLink()) throw Error("ThinkFlow 写入只接受普通文件。");
+			return digest(await fs.readFile(file));
+		} catch (error) {
+			if ((error as NodeJS.ErrnoException).code === "ENOENT") {
+				for (let parent = path.dirname(file); ; parent = path.dirname(parent)) {
+					const ancestor = await fs.stat(parent).catch(parentError => {
+						if ((parentError as NodeJS.ErrnoException).code === "ENOENT") return undefined;
+						throw parentError;
+					});
+					if (ancestor) {
+						if (!ancestor.isDirectory()) throw Error("ThinkFlow 不将档案成员或数据库选择器当作普通文件写入。");
+						break;
+					}
+					if (path.dirname(parent) === parent) break;
+				}
+				return null;
+			}
+			throw error;
+		}
+	}
+	async prepare(command: ThinkFlowCommand, args: Record<string, unknown>) {
+		const record = { ...this.base(command), args };
+		if (command.tool === "write") {
+			const file = this.localFile(args.path),
+				before = await this.version(file);
+			if (before !== null && this.baselines.get(file) !== before)
+				throw Error(
+					"文件缺少有效完整读取基线或已发生改动；先 tf-read 当前文件，再决定新的写入，不直接重放旧覆盖。",
+				);
+			record.fileVersion = { path: file, before };
+			args.path = file;
+		} else if (command.tool === "read") args.path = `${this.localFile(String(args.path).replace(/:raw$/, ""))}:raw`;
+		await this.save("intent", record);
+		this.pending.set(command.id, record);
+	}
+	async complete(
+		command: ThinkFlowCommand,
+		result: AgentToolResult<unknown>,
+		aborted: boolean,
+		status?: ThinkFlowStatus,
+	) {
+		const intent = this.pending.get(command.id),
+			hasError = failed(result);
+		const receipt: ThinkFlowReceipt = {
+			...(intent ?? this.base(command)),
+			result,
+			status: status ?? (hasError ? (aborted ? "cancelled" : "error") : "success"),
+			completedAt: Date.now(),
+			...(hasError ? { error: resultText(result) } : {}),
+		};
+		if (receipt.status === "success" && command.tool === "read") {
+			try {
+				const file = this.localFile(String(receipt.args.path).replace(/:raw$/, "")),
+					bytes = await fs.readFile(file),
+					content = new TextDecoder("utf-8", { fatal: true }).decode(bytes);
+				if (bytes.length <= 2 * 1024 * 1024 && !content.includes("\0") && resultText(result).includes(content)) {
+					const version = digest(bytes);
+					this.baselines.set(file, version);
+					receipt.fileVersion = { path: file, before: version, after: version };
+				}
+			} catch {
+				/* 原生读取结果仍有效；无法核实完整内容时不授予写入基线。 */
+			}
+		}
+		if (receipt.status === "success" && command.tool === "write" && receipt.fileVersion) {
+			const after = await this.version(receipt.fileVersion.path);
+			receipt.fileVersion.after = after;
+			if (after !== null) this.baselines.set(receipt.fileVersion.path, after);
+		}
+		await this.save("receipt", receipt);
+		this.pending.delete(command.id);
+		return receipt;
+	}
+	observation(receipts: ThinkFlowReceipt[]): AgentMessage {
+		const observations = receipts.map(receipt => ({
+			id: receipt.id,
+			tool: receipt.tool,
+			status: receipt.status,
+			...(receipt.fileVersion
+				? { path: receipt.fileVersion.path, version: receipt.fileVersion.after ?? receipt.fileVersion.before }
+				: {}),
+			...(receipt.error ? { error: receipt.error } : {}),
+			...(receipt.flow === "feedback" && receipt.result ? { result: receipt.result.content } : {}),
+		}));
+		return {
+			role: "custom",
+			customType: "thinkflow-observation",
+			content: `ThinkFlow 执行回执：\n${JSON.stringify(observations)}\n成功只表示工具执行完成。依赖新信息再继续；unknown 须核对实际效果后再决定新动作。`,
+			display: true,
+			details: { thinkflow: { schemaVersion: 1, receipts } },
+			attribution: "agent",
+			timestamp: Date.now(),
+		};
+	}
+}
