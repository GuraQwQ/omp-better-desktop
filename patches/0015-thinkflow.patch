@@ -0,0 +1,297 @@
+import type { AgentMessage, AgentToolResult } from "./types";
+
+export type ThinkFlowStatus = "queued" | "running" | "success" | "error" | "skipped" | "cancelled" | "unknown";
+export interface ThinkFlowSource {
+	contentIndex: number;
+	start: number;
+	end: number;
+	text: string;
+	assistantTimestamp: number;
+}
+export interface ThinkFlowCommand {
+	id: string;
+	tool: "write" | "read" | "bash";
+	args: Record<string, unknown>;
+	needResult: boolean;
+	source: ThinkFlowSource;
+}
+export interface ThinkFlowReceipt {
+	schemaVersion: 1;
+	id: string;
+	tool: string;
+	args: Record<string, unknown>;
+	fingerprint: string;
+	flow: "delayed" | "feedback";
+	status: ThinkFlowStatus;
+	startedAt: number;
+	completedAt?: number;
+	source?: ThinkFlowSource;
+	result?: AgentToolResult<unknown>;
+	error?: string;
+	fileVersion?: { path: string; before: string | null; after?: string | null };
+}
+export interface ThinkFlowHost {
+	lookup(command: ThinkFlowCommand): Promise<ThinkFlowReceipt | undefined>;
+	prepare(command: ThinkFlowCommand, args: Record<string, unknown>): Promise<void>;
+	complete(
+		command: ThinkFlowCommand,
+		result: AgentToolResult<unknown>,
+		aborted: boolean,
+		status?: ThinkFlowStatus,
+	): Promise<ThinkFlowReceipt>;
+	observation(receipts: ThinkFlowReceipt[]): AgentMessage;
+}
+export const THINKFLOW_PROMPT = `ThinkFlow is enabled for this run. Emit executable commands only as standalone top-level text, outside Markdown code fences. Keep native tools for edit, task, wait, eval, ask, todo, MCP and other operations.
+<tf-write id="unique-id" path="local-file">complete file content</tf-write>
+<tf-read id="unique-id" path="local-file" />
+<tf-bash id="unique-id">complete shell command</tf-bash>
+Commands execute once, in order, as soon as each complete tag arrives. Use a stable id for the same command; never reuse an id with changed arguments. Existing files require a successful full tf-read baseline before tf-write. A changed file must be read again before deciding a new write. Virtual URI writes use native tools.
+Successful tf-write receipts do not force another model request. tf-read and tf-bash results return after the current response. Add need_result="true" to any command when later work needs its result immediately: execution finishes, then the provider stream stops and a new request receives the observation. Do not generate dependent edits before seeing read/bash results. Native tools wait for preceding ThinkFlow commands. A stopped or failed command never rolls back earlier successes. Escape a literal closing tag in a write/bash body as &lt;/tf-write> or &lt;/tf-bash>. Do not manufacture result tags or claim business completion merely from execution success.`;
+
+const MAX_COMMAND = 2 * 1024 * 1024;
+const decodeAttribute = (value: string) =>
+	value.replace(
+		/&(quot|apos|amp|lt|gt);/g,
+		(_, name: string) => ({ quot: '"', apos: "'", amp: "&", lt: "<", gt: ">" })[name]!,
+	);
+
+/** 只扫描本次正文的完整顶层命令，围栏示例及未闭合尾部不产生副作用。 */
+export class ThinkFlowScanner {
+	private readonly blocks = new Map<number, { text: string; cursor: number; fence?: string }>();
+	private readonly accepted: ThinkFlowCommand[] = [];
+	constructor(private readonly timestamp: () => number) {}
+	push(index: number, delta: string): ThinkFlowCommand[] {
+		const state = this.blocks.get(index) ?? { text: "", cursor: 0 };
+		this.blocks.set(index, state);
+		state.text += delta;
+		const commands: ThinkFlowCommand[] = [];
+		while (state.cursor < state.text.length) {
+			const start = state.cursor;
+			const lineStart = state.text.lastIndexOf("\n", start - 1) + 1;
+			const topLevel = /^\s*$/.test(state.text.slice(lineStart, start));
+			if (topLevel && (state.text[start] === "`" || state.text[start] === "~")) {
+				const end = state.text.indexOf("\n", start);
+				if (end < 0) break;
+				const fence = /^(`{3,}|~{3,})/.exec(state.text.slice(start, end))?.[1];
+				if (fence) {
+					if (!state.fence) state.fence = fence;
+					else if (
+						state.fence[0] === fence[0] &&
+						fence.length >= state.fence.length &&
+						!state.text.slice(start + fence.length, end).trim()
+					)
+						delete state.fence;
+				}
+				state.cursor = end + 1;
+				continue;
+			}
+			if (state.fence || !topLevel || state.text[start] !== "<") {
+				state.cursor++;
+				continue;
+			}
+			const remainder = state.text.slice(start);
+			if ("<tf-".startsWith(remainder)) break;
+			if (!remainder.startsWith("<tf-")) {
+				state.cursor++;
+				continue;
+			}
+			let end = start + 4,
+				quote = "";
+			for (; end < state.text.length; end++) {
+				const char = state.text[end];
+				if (quote) {
+					if (char === quote) quote = "";
+				} else if (char === '"' || char === "'") quote = char;
+				else if (char === ">") break;
+			}
+			if (end === state.text.length) {
+				if (end - start > MAX_COMMAND) throw Error("ThinkFlow 命令开标签过长。");
+				break;
+			}
+			const opening = state.text.slice(start, end + 1);
+			const match = /^<tf-(write|read|bash)\b([\s\S]*?)(\/?)>$/.exec(opening);
+			if (!match) throw Error("ThinkFlow 仅支持完整的 tf-write、tf-read 和 tf-bash 标签。");
+			const tool = match[1] as ThinkFlowCommand["tool"];
+			const attributes: Record<string, string> = {};
+			let rest = match[2].trim();
+			while (rest) {
+				const attribute = /^([a-z_]+)\s*=\s*(?:"([^"]*)"|'([^']*)')\s*/.exec(rest);
+				if (!attribute || attributes[attribute[1]] !== undefined) throw Error("ThinkFlow 属性必须唯一并使用引号。");
+				attributes[attribute[1]] = decodeAttribute(attribute[2] ?? attribute[3]);
+				rest = rest.slice(attribute[0].length);
+			}
+			if (!/^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$/.test(attributes.id ?? ""))
+				throw Error("ThinkFlow 命令需要稳定、非空的 id（最长 128 字符）。");
+			if (Object.keys(attributes).some(name => !["id", "path", "need_result"].includes(name)))
+				throw Error("ThinkFlow 命令包含不支持的属性。");
+			if (attributes.need_result !== undefined && !["true", "false"].includes(attributes.need_result))
+				throw Error("need_result 必须为 true 或 false。");
+			if (tool !== "bash" && !attributes.path) throw Error("ThinkFlow 文件命令需要 path。");
+			let body = "",
+				finish = end + 1;
+			if (!match[3]) {
+				const closing = `</tf-${tool}>`,
+					close = state.text.indexOf(closing, finish);
+				if (close < 0) {
+					if (state.text.length - start > MAX_COMMAND) throw Error("ThinkFlow 命令超过 2 MiB。");
+					break;
+				}
+				body = state.text.slice(finish, close).replaceAll(`&lt;/tf-${tool}>`, closing);
+				finish = close + closing.length;
+			} else if (tool !== "read") throw Error("tf-write 和 tf-bash 必须有完整结束标签。");
+			if (finish - start > MAX_COMMAND) throw Error("ThinkFlow 命令超过 2 MiB。");
+			const command: ThinkFlowCommand = {
+				id: attributes.id,
+				tool,
+				args:
+					tool === "write"
+						? { path: attributes.path, content: body }
+						: tool === "read"
+							? { path: attributes.path }
+							: { command: body },
+				needResult: attributes.need_result === "true",
+				source: {
+					contentIndex: index,
+					start,
+					end: finish,
+					text: state.text.slice(start, finish),
+					assistantTimestamp: this.timestamp(),
+				},
+			};
+			commands.push(command);
+			this.accepted.push(command);
+			state.cursor = finish;
+		}
+		return commands;
+	}
+	take() {
+		return this.accepted.splice(0);
+	}
+	finish() {
+		for (const state of this.blocks.values())
+			if (!state.fence && state.text.slice(state.cursor).startsWith("<tf-"))
+				throw Error("ThinkFlow 命令未闭合，未执行残缺尾部；请重新给出完整命令。");
+	}
+}
+
+/** 请求内 FIFO；只反馈新信息，副作用失败后不继续依赖链。 */
+export class ThinkFlowQueue {
+	readonly receipts: ThinkFlowReceipt[] = [];
+	readonly feedbackReady = Promise.withResolvers<void>();
+	private tail: Promise<void> = Promise.resolve();
+	private closed = false;
+	private effectFailed = false;
+	private readFailed = false;
+	private count = 0;
+	private bytes = 0;
+	private persistenceFailed = false;
+	feedback = false;
+	unknown = false;
+	get blocksNative() {
+		return this.closed || this.effectFailed || this.readFailed;
+	}
+	constructor(
+		readonly host: ThinkFlowHost,
+		private readonly execute: (command: ThinkFlowCommand) => Promise<ThinkFlowReceipt>,
+		private readonly emit: (receipt: ThinkFlowReceipt) => void,
+		private readonly signal?: AbortSignal,
+	) {}
+	async add(command: ThinkFlowCommand) {
+		if (++this.count > 128) throw Error("单次 ThinkFlow 响应最多接受 128 条命令。");
+		const size = command.source.text.length;
+		if (this.bytes + size > 4 * 1024 * 1024) await this.tail;
+		this.bytes += size;
+		const queued: ThinkFlowReceipt = {
+			schemaVersion: 1,
+			id: command.id,
+			tool: command.tool,
+			args: command.args,
+			fingerprint: "",
+			flow: command.tool === "write" && !command.needResult ? "delayed" : "feedback",
+			status: "queued",
+			startedAt: Date.now(),
+			source: command.source,
+		};
+		this.emit(queued);
+		const skip = this.closed;
+		if (command.needResult) this.closed = true;
+		this.tail = this.tail
+			.then(async () => {
+				let receipt: ThinkFlowReceipt;
+				try {
+					if (this.persistenceFailed) {
+						receipt = {
+							...queued,
+							status: "skipped",
+							completedAt: Date.now(),
+							error: "前序回执无法持久化，本项未执行。",
+						};
+					} else if (
+						skip ||
+						this.effectFailed ||
+						(this.readFailed && command.tool !== "read") ||
+						this.signal?.aborted
+					) {
+						receipt = await this.host.complete(
+							command,
+							{
+								content: [{ type: "text", text: "前序反馈、失败或取消阻止了本项执行。" }],
+								isError: true,
+								details: {},
+							},
+							!!this.signal?.aborted,
+							this.signal?.aborted ? "cancelled" : "skipped",
+						);
+					} else {
+						this.emit({ ...queued, status: "running" });
+						receipt = (await this.host.lookup(command)) ?? (await this.execute(command));
+					}
+				} catch (error) {
+					this.persistenceFailed = true;
+					this.closed = true;
+					receipt = {
+						...queued,
+						status: "unknown",
+						flow: "feedback",
+						completedAt: Date.now(),
+						error: `执行或回执未能确定结算：${String(error instanceof Error ? error.message : error)}。保留原意图，先核对实际效果。`,
+					};
+				}
+				this.receipts.push(receipt);
+				this.emit(receipt);
+				if (receipt.status === "unknown") this.unknown = true;
+				if (receipt.status !== "success") {
+					if (command.tool === "read" && receipt.status === "error") this.readFailed = true;
+					else this.effectFailed = true;
+				}
+				if (receipt.flow === "feedback" || receipt.status !== "success") this.feedback = true;
+				if (command.needResult || (receipt.status !== "success" && command.tool !== "read"))
+					this.feedbackReady.resolve();
+			})
+			.finally(() => {
+				this.bytes -= size;
+			});
+	}
+	async finish() {
+		await this.tail;
+	}
+	protocolError(error: unknown) {
+		this.closed = true;
+		this.feedback = true;
+		const receipt: ThinkFlowReceipt = {
+			schemaVersion: 1,
+			id: `protocol-${Date.now()}`,
+			tool: "protocol",
+			args: {},
+			fingerprint: "",
+			flow: "feedback",
+			status: "error",
+			startedAt: Date.now(),
+			completedAt: Date.now(),
+			error: String(error instanceof Error ? error.message : error),
+		};
+		this.receipts.push(receipt);
+		this.emit(receipt);
+		this.feedbackReady.resolve();
+	}
+}
