+import * as path from "node:path";
+import { createInterface } from "node:readline";
+import { SkillDescriptionCatalog, SkillDescriptionStore } from "../../src/extensibility/skill-descriptions";
+import type { Skill } from "../../src/extensibility/skills";
+
+const [dbPath, enabled, leaseMs] = process.argv.slice(2);
+if (!dbPath) throw new Error("需要隔离的缓存路径");
+globalThis.fetch = (() => {
+	throw new Error("技能缓存测试禁止网络请求");
+}) as unknown as typeof fetch;
+const store = SkillDescriptionStore.open(dbPath, leaseMs ? { leaseMs: Number(leaseMs) } : undefined);
+const replies = new Map<string, ReturnType<typeof Promise.withResolvers<string>>>();
+const emit = (event: Record<string, unknown>) =>
+	process.stdout.write(`${JSON.stringify({ pid: process.pid, ...event })}\n`);
+const description =
+	"Use when planning or reviewing multi-step data migrations across services, checking rollout dependencies, preserving data consistency, and preparing safe rollback procedures.";
+emit({ type: "ready" });
+for await (const line of createInterface({ input: process.stdin })) {
+	const command = JSON.parse(line);
+	if (command.type === "render") {
+		const entries: Skill[] = (command.names ?? ["migrations"]).map((name: string) => ({
+			name,
+			description,
+			filePath: path.join(path.dirname(dbPath), name, "SKILL.md"),
+			baseDir: path.join(path.dirname(dbPath), name),
+			source: "native:project",
+		}));
+		const catalog = new SkillDescriptionCatalog({
+			store,
+			reuseCache: enabled === "true",
+			compress: {
+				modelKey: () => command.model ?? "test/fast",
+				compress: async name => {
+					const call = `${command.id}:${name}`;
+					const reply = Promise.withResolvers<string>();
+					replies.set(call, reply);
+					emit({ type: "compress", id: command.id, call, name });
+					return reply.promise;
+				},
+			},
+		});
+		const started = performance.now();
+		const rendered = catalog.render(entries).map(skill => skill.description);
+		emit({ type: "rendered", id: command.id, rendered, elapsedMs: performance.now() - started });
+		void catalog.waitForPending().then(() =>
+			emit({
+				type: "done",
+				id: command.id,
+				rendered: catalog.render(entries).map(skill => skill.description),
+				fresh: new SkillDescriptionCatalog({ store }).render(entries).map(skill => skill.description),
+			}),
+		);
+	} else if (command.type === "reply") {
+		const reply = replies.get(command.call);
+		if (!reply) throw new Error("未知的测试压缩调用");
+		replies.delete(command.call);
+		if (command.error) reply.reject(new Error(command.error));
+		else reply.resolve(command.text ?? "Use for planning and reviewing data migrations.");
+	} else if (command.type === "close") {
+		await store.close();
+		emit({ type: "closed" });
+		process.exit(0);
+	}
+}
+await store.close();
