+++ b/packages/coding-agent/src/extensibility/skill-description-claims.ts
@@ -0,0 +1,82 @@
+import type { Database, Statement } from "bun:sqlite";
+
+// 原压缩请求有 30 秒超时；租约留出写库余量，终止进程无需常驻清理服务。
+const LEASE_MS = 45_000;
+const POLL_MS = 250;
+
+export type SkillDescriptionClaim =
+	| { status: "complete" }
+	| { status: "wait"; retryMs: number }
+	| { status: "owned"; owner: string };
+export interface SkillDescriptionClaimOptions {
+	/** 仅供嵌入调用与测试缩短恢复时间，不新增用户配置。 */
+	leaseMs?: number;
+}
+
+/** 复用描述库中的短事务；只在显式启用缓存协调后构造。 */
+export class SkillDescriptionClaims {
+	readonly #db: Database;
+	readonly #leaseMs: number;
+	readonly #cached: Statement<{ key: string }, [string, string | null]>;
+	readonly #lease: Statement<{ owner: string; expires_at: number }, [string]>;
+	readonly #insert: Statement<unknown, [string, string, number]>;
+	readonly #release: Statement<unknown, [string, string]>;
+	readonly #expired: Statement<unknown, [number]>;
+	readonly #put: Statement<unknown, [string, string]>;
+	readonly #owned = new Map<string, string>();
+
+	constructor(db: Database, options: SkillDescriptionClaimOptions = {}) {
+		this.#db = db;
+		this.#leaseMs = options.leaseMs ?? LEASE_MS;
+		db.run(
+			"CREATE TABLE IF NOT EXISTS skill_description_claims (key TEXT PRIMARY KEY, owner TEXT NOT NULL, expires_at INTEGER NOT NULL)",
+		);
+		db.run("CREATE INDEX IF NOT EXISTS skill_description_claims_expiry ON skill_description_claims(expires_at)");
+		this.#cached = db.prepare("SELECT key FROM skill_descriptions WHERE key IN (?, ?) LIMIT 1");
+		this.#lease = db.prepare("SELECT owner, expires_at FROM skill_description_claims WHERE key = ?");
+		this.#insert = db.prepare("INSERT INTO skill_description_claims (key, owner, expires_at) VALUES (?, ?, ?)");
+		this.#release = db.prepare("DELETE FROM skill_description_claims WHERE key = ? AND owner = ?");
+		this.#expired = db.prepare("DELETE FROM skill_description_claims WHERE expires_at <= ?");
+		this.#put = db.prepare("INSERT OR IGNORE INTO skill_descriptions (key, description) VALUES (?, ?)");
+	}
+
+	claim(key: string, unusableKey?: string): SkillDescriptionClaim {
+		const result = this.#db
+			.transaction((): SkillDescriptionClaim => {
+				const now = Date.now();
+				this.#expired.run(now);
+				if (this.#cached.get(key, unusableKey ?? null)) return { status: "complete" };
+				const lease = this.#lease.get(key);
+				if (lease) return { status: "wait", retryMs: Math.min(POLL_MS, Math.max(1, lease.expires_at - now)) };
+				const owner = crypto.randomUUID();
+				this.#insert.run(key, owner, now + this.#leaseMs);
+				return { status: "owned", owner };
+			})
+			.immediate();
+		if (result.status === "owned") this.#owned.set(key, result.owner);
+		return result;
+	}
+
+	/** 完成结果和释放租约同批提交；过期接管后的迟到结果不能覆盖新持有者。 */
+	finish(key: string, owner: string, result?: { key: string; description: string }): void {
+		this.#db
+			.transaction(() => {
+				if (this.#lease.get(key)?.owner !== owner) return;
+				if (result) this.#put.run(result.key, result.description);
+				this.#release.run(key, owner);
+			})
+			.immediate();
+		if (this.#owned.get(key) === owner) this.#owned.delete(key);
+	}
+
+	close(): void {
+		try {
+			for (const [key, owner] of this.#owned) this.#release.run(key, owner);
+			this.#expired.run(Date.now());
+		} finally {
+			this.#owned.clear();
+			for (const statement of [this.#cached, this.#lease, this.#insert, this.#release, this.#expired, this.#put])
+				statement.finalize();
+		}
+	}
+}
