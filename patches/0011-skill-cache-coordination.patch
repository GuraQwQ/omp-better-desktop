+++ b/packages/coding-agent/test/skill-description-coordination.test.ts
@@ -0,0 +1,264 @@
+import { Database } from "bun:sqlite";
+import { afterEach, beforeEach, expect, it } from "bun:test";
+import * as fs from "node:fs/promises";
+import * as os from "node:os";
+import * as path from "node:path";
+
+type Event = {
+	type: string;
+	pid: number;
+	id?: string;
+	call?: string;
+	name?: string;
+	rendered?: string[];
+	fresh?: string[];
+	elapsedMs?: number;
+};
+const fixture = path.join(import.meta.dir, "fixtures/skill-description-worker.ts");
+const compressed = "Use for planning and reviewing data migrations.";
+let directory: string;
+let dbPath: string;
+const workers: Worker[] = [];
+
+class Worker {
+	readonly events: Event[] = [];
+	readonly process;
+	readonly stderr: Promise<string>;
+	readonly read: Promise<void>;
+
+	constructor(enabled: boolean, leaseMs?: number) {
+		const child = Bun.spawn(
+			[process.execPath, fixture, dbPath, String(enabled), ...(leaseMs ? [String(leaseMs)] : [])],
+			{ stdin: "pipe", stdout: "pipe", stderr: "pipe" },
+		);
+		this.process = child;
+		this.stderr = new Response(child.stderr).text();
+		this.read = (async () => {
+			let pending = "";
+			const decoder = new TextDecoder();
+			for await (const bytes of child.stdout) {
+				pending += decoder.decode(bytes, { stream: true });
+				let end: number;
+				while ((end = pending.indexOf("\n")) >= 0) {
+					this.events.push(JSON.parse(pending.slice(0, end)));
+					pending = pending.slice(end + 1);
+				}
+			}
+		})();
+		workers.push(this);
+	}
+
+	send(command: Record<string, unknown>): void {
+		this.process.stdin.write(`${JSON.stringify(command)}\n`);
+	}
+	async event(type: string, id?: string): Promise<Event> {
+		await until(() => this.events.some(event => event.type === type && (id === undefined || event.id === id)));
+		return this.events.find(event => event.type === type && (id === undefined || event.id === id))!;
+	}
+	get calls(): Event[] {
+		return this.events.filter(event => event.type === "compress");
+	}
+	async close(): Promise<void> {
+		this.send({ type: "close" });
+		await this.event("closed");
+		expect(await this.process.exited).toBe(0);
+	}
+}
+
+async function until(condition: () => boolean, timeout = 8_000): Promise<void> {
+	const deadline = Date.now() + timeout;
+	while (!condition()) {
+		if (Date.now() >= deadline)
+			throw new Error(`等待子进程超时：${JSON.stringify(workers.map(worker => worker.events))}`);
+		await Bun.sleep(10);
+	}
+}
+
+async function pair(enabled = true, leaseMs?: number): Promise<[Worker, Worker]> {
+	const first = new Worker(enabled, leaseMs);
+	await first.event("ready");
+	const second = new Worker(enabled, leaseMs);
+	await second.event("ready");
+	expect(first.process.pid).not.toBe(second.process.pid);
+	return [first, second];
+}
+
+function claims(): number {
+	using db = new Database(dbPath, { readonly: true });
+	return db.query<{ total: number }, []>("SELECT COUNT(*) AS total FROM skill_description_claims").get()!.total;
+}
+
+beforeEach(async () => {
+	directory = await fs.mkdtemp(path.join(os.tmpdir(), "omp-skill-coordination-"));
+	dbPath = path.join(directory, "shared.db");
+});
+
+afterEach(async () => {
+	for (const worker of workers) worker.process.kill();
+	await Promise.all(
+		workers.map(async worker => {
+			await worker.process.exited;
+			await worker.read;
+			await worker.stderr;
+		}),
+	);
+	workers.length = 0;
+	await fs.rm(directory, { recursive: true, force: true });
+});
+
+it.each([false, true])("双进程同一未命中：开关为 %s 时保持对应调用数与冻结预览", async enabled => {
+	const pairWorkers = await pair(enabled);
+	for (const worker of pairWorkers) worker.send({ type: "render", id: "shared" });
+	const previews = await Promise.all(pairWorkers.map(worker => worker.event("rendered", "shared")));
+	await until(() => pairWorkers.reduce((sum, worker) => sum + worker.calls.length, 0) >= (enabled ? 1 : 2));
+	await Bun.sleep(100);
+	expect(pairWorkers.reduce((sum, worker) => sum + worker.calls.length, 0)).toBe(enabled ? 1 : 2);
+	for (const worker of pairWorkers) for (const call of worker.calls) worker.send({ type: "reply", call: call.call });
+	const done = await Promise.all(pairWorkers.map(worker => worker.event("done", "shared")));
+	for (let i = 0; i < done.length; i++) {
+		expect(done[i].rendered).toEqual(previews[i].rendered);
+		expect(done[i].fresh).toEqual([compressed]);
+	}
+	using db = new Database(dbPath, { readonly: true });
+	const table = db.query("SELECT name FROM sqlite_master WHERE name = 'skill_description_claims'").get();
+	expect(Boolean(table)).toBe(enabled);
+	if (enabled) expect(claims()).toBe(0);
+	console.log(
+		JSON.stringify({
+			scenario: "two-process-miss",
+			enabled,
+			pids: pairWorkers.map(worker => worker.process.pid),
+			compressionCalls: pairWorkers.reduce((sum, worker) => sum + worker.calls.length, 0),
+			renderMs: previews.map(event => event.elapsedMs),
+		}),
+	);
+});
+
+it("另一真实进程复用已成功缓存，不启动压缩", async () => {
+	const [first, second] = await pair();
+	first.send({ type: "render", id: "first" });
+	const call = await first.event("compress", "first");
+	first.send({ type: "reply", call: call.call });
+	await first.event("done", "first");
+	second.send({ type: "render", id: "cached" });
+	expect((await second.event("done", "cached")).rendered).toEqual([compressed]);
+	expect(second.calls).toHaveLength(0);
+	expect(claims()).toBe(0);
+});
+
+it("排队期间另一进程完成后复用，排队任务不提前占用租约", async () => {
+	const [queued, writer] = await pair();
+	queued.send({ type: "render", id: "blockers", names: ["one", "two", "three", "four"] });
+	await until(() => queued.calls.length === 4);
+	queued.send({ type: "render", id: "queued" });
+	await queued.event("rendered", "queued");
+	expect(claims()).toBe(4);
+	writer.send({ type: "render", id: "writer" });
+	const call = await writer.event("compress", "writer");
+	writer.send({ type: "reply", call: call.call });
+	await writer.event("done", "writer");
+	for (const call of queued.calls) queued.send({ type: "reply", call: call.call });
+	await queued.event("done", "queued");
+	expect(queued.calls).toHaveLength(4);
+	expect(claims()).toBe(0);
+});
+
+it("等待其他进程时释放压缩槽，独立技能继续执行", async () => {
+	const [owner, waiting] = await pair();
+	owner.send({ type: "render", id: "owners", names: ["one", "two", "three", "four"] });
+	await until(() => owner.calls.length === 4);
+	waiting.send({ type: "render", id: "waiting", names: ["one", "two", "three", "four", "independent"] });
+	const independent = await waiting.event("compress", "waiting");
+	expect(independent.name).toBe("independent");
+	waiting.send({ type: "reply", call: independent.call });
+	for (const call of owner.calls) owner.send({ type: "reply", call: call.call });
+	await waiting.event("done", "waiting");
+	expect(waiting.calls).toHaveLength(1);
+	expect(claims()).toBe(0);
+});
+
+it("持有者模型失败后释放认领，等待进程恢复压缩", async () => {
+	const [owner, waiting] = await pair();
+	owner.send({ type: "render", id: "owner" });
+	const first = await owner.event("compress", "owner");
+	waiting.send({ type: "render", id: "waiting" });
+	await waiting.event("rendered", "waiting");
+	owner.send({ type: "reply", call: first.call, error: "本地模拟传输失败" });
+	const retry = await waiting.event("compress", "waiting");
+	waiting.send({ type: "reply", call: retry.call });
+	expect((await waiting.event("done", "waiting")).fresh).toEqual([compressed]);
+	expect(claims()).toBe(0);
+});
+
+it("持有者真正终止后按短租约恢复，并清理无关过期认领", async () => {
+	const [owner, waiting] = await pair(true, 450);
+	owner.send({ type: "render", id: "owner" });
+	await owner.event("compress", "owner");
+	waiting.send({ type: "render", id: "waiting" });
+	await waiting.event("rendered", "waiting");
+	owner.process.kill();
+	await owner.process.exited;
+	using db = new Database(dbPath);
+	db.run("INSERT INTO skill_description_claims VALUES ('abandoned', 'terminated', ?)", [Date.now() - 1]);
+	const retry = await waiting.event("compress", "waiting");
+	waiting.send({ type: "reply", call: retry.call });
+	await waiting.event("done", "waiting");
+	expect(claims()).toBe(0);
+});
+
+it("租约过期接管后，旧持有者迟到结果不能覆盖成功缓存", async () => {
+	const [old, current] = await pair(true, 300);
+	old.send({ type: "render", id: "old" });
+	const stale = await old.event("compress", "old");
+	current.send({ type: "render", id: "current" });
+	const replacement = await current.event("compress", "current");
+	current.send({ type: "reply", call: replacement.call, text: "New successful routing description." });
+	await current.event("done", "current");
+	old.send({ type: "reply", call: stale.call, text: "Old delayed routing description." });
+	expect((await old.event("done", "old")).fresh).toEqual(["New successful routing description."]);
+	expect(claims()).toBe(0);
+});
+
+it("无效模型结果阻止同模型重复请求，换模型后可继续", async () => {
+	const [owner, waiting] = await pair();
+	owner.send({ type: "render", id: "invalid" });
+	const invalid = await owner.event("compress", "invalid");
+	waiting.send({ type: "render", id: "waiting" });
+	await waiting.event("rendered", "waiting");
+	owner.send({ type: "reply", call: invalid.call, text: "Invalid\nmultiple lines" });
+	await waiting.event("done", "waiting");
+	expect(waiting.calls).toHaveLength(0);
