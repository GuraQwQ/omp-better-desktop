index 0000000..8df37e3
--- /dev/null
+++ b/packages/utils/test/desktop-root.test.ts
@@ -0,0 +1,42 @@
+import { afterEach, describe, expect, it } from "bun:test";
+import * as path from "node:path";
+import * as os from "node:os";
+import { __resetDirsFromEnvForTests, getAgentDir, getBaseConfigRoot, getConfigRootDir } from "../src/dirs";
+
+const original = {
+	root: process.env.OMP_USER_ROOT,
+	profile: process.env.OMP_PROFILE,
+	agent: process.env.PI_CODING_AGENT_DIR,
+};
+afterEach(() => {
+	for (const [key, value] of Object.entries({
+		OMP_USER_ROOT: original.root,
+		OMP_PROFILE: original.profile,
+		PI_CODING_AGENT_DIR: original.agent,
+	})) {
+		if (value === undefined) delete process.env[key];
+		else process.env[key] = value;
+	}
+	__resetDirsFromEnvForTests();
+});
+
+describe("desktop data root", () => {
+	it("keeps named profiles and the default agent under one absolute root", () => {
+		const root = path.join(os.tmpdir(), "omp-desktop-root-test");
+		process.env.OMP_USER_ROOT = root;
+		process.env.OMP_PROFILE = "work";
+		process.env.PI_CODING_AGENT_DIR = path.join(os.tmpdir(), "unrelated-agent");
+		__resetDirsFromEnvForTests();
+		expect(getBaseConfigRoot()).toBe(root);
+		expect(getConfigRootDir()).toBe(path.join(root, "profiles", "work"));
+		expect(getAgentDir()).toBe(path.join(root, "profiles", "work", "agent"));
+		process.env.OMP_PROFILE = "default";
+		__resetDirsFromEnvForTests();
+		expect(getAgentDir()).toBe(path.join(root, "agent"));
+	});
+
+	it("rejects a relative root instead of silently writing to the launch directory", () => {
+		process.env.OMP_USER_ROOT = "relative-data";
+		expect(() => getBaseConfigRoot()).toThrow("absolute path");
+	});
+});
