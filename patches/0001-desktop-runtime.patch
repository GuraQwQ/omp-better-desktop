new file mode 100644
index 0000000000..c6c053c0f8
--- /dev/null
+++ b/packages/coding-agent/src/modes/rpc/desktop.ts
@@ -0,0 +1,53 @@
+import { orderedSettings } from "../../config/all-settings";
+import { lookup } from "../../config/registry";
+import type { Settings } from "../../config/settings";
+import { BUILTIN_SLASH_COMMANDS_INTERNAL } from "../../slash-commands/builtin-registry";
+
+export interface DesktopSettingsRequest {
+	operation: "list" | "set" | "unset";
+	key?: string;
+	value?: unknown;
+}
+
+export async function desktopSettings(settings: Settings, request: DesktopSettingsRequest): Promise<object> {
+	if (request.operation !== "list") {
+		if (request.operation !== "set" && request.operation !== "unset") throw new Error("Unknown settings operation");
+		const setting = request.key ? lookup(request.key) : undefined;
+		if (!setting) throw new Error(`Unknown setting: ${request.key ?? ""}`);
+		if (request.operation === "unset") setting.unset(settings);
+		else {
+			if (!Object.hasOwn(request, "value")) throw new Error("A setting value is required");
+			setting.assertWritable(request.value);
+			setting.set(settings, request.value);
+		}
+		await settings.flush();
+	}
+	return {
+		settings: orderedSettings().map(setting => ({
+			key: setting.id,
+			path: setting.id,
+			type: setting.type,
+			defaultValue: setting.isCredential ? undefined : setting.default,
+			value: setting.isCredential ? undefined : setting.layered(settings),
+			credential: setting.isCredential,
+			configured: setting.isCredential ? Boolean(setting.layered(settings)) : undefined,
+			enumValues: setting.enumValues,
+			ui: setting.ui,
+			provenance: setting.provenance(settings),
+		})),
+	};
+}
+
+export function desktopCommands(): object {
+	return {
+		commands: BUILTIN_SLASH_COMMANDS_INTERNAL.map(command => ({
+			name: command.name,
+			aliases: command.aliases,
+			description: command.description,
+			inputHint: command.inlineHint,
+			subcommands: command.subcommands,
+			rpc: command.handle !== undefined,
+			tui: command.handleTui !== undefined,
+		})),
+	};
+}
