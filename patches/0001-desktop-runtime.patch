@@ -0,0 +1,14 @@
+import { describe, expect, it } from "bun:test";
+import { Settings } from "../src/config/settings";
+import { desktopSettings } from "../src/modes/rpc/desktop";
+
+describe("desktop settings", () => {
+	it("rejects invalid values without changing the session setting", async () => {
+		const settings = Settings.isolated();
+		await expect(desktopSettings(settings, { operation: "set", key: "tools.xdev", value: "yes" })).rejects.toThrow();
+		const result = (await desktopSettings(settings, { operation: "list" })) as {
+			settings: { key: string; value: unknown }[];
+		};
+		expect(result.settings.find(setting => setting.key === "tools.xdev")?.value).toBe(true);
+	});
+});
