+import * as fs from "node:fs/promises";
+import * as os from "node:os";
+import * as path from "node:path";
+import { createHash } from "node:crypto";
+import { getBaseConfigRoot, parseFrontmatter } from "@oh-my-pi/pi-utils";
+import { withFileLock } from "@oh-my-pi/pi-utils/file-lock";
+import { registerProvider } from "../capability";
+import { mcpCapability, type MCPServer } from "../capability/mcp";
+import { skillCapability, type Skill } from "../capability/skill";
+import type { LoadResult, SourceMeta } from "../capability/types";
+import { writeFileAtomically } from "../utils/atomic-file";
+import { discoverMcpSource, snapshotMcpSource, type McpImportAdapter } from "./desktop-import-mcp";
+
+type Adapter = "skill" | McpImportAdapter;
+export interface DesktopImportItem {
+	id: string;
+	name: string;
+	kind: "skill" | "mcp";
+	source: string;
+	path: string;
+	description?: string;
+	adapter?: Adapter;
+	key?: string;
+	enabled?: boolean;
+	managedPath?: string;
+	revision?: string;
+	context?: string;
+	executionDirectory?: string;
+	migrationPending?: boolean;
+	problem?: string;
+	warning?: string;
+}
+interface Source {
+	id: string;
+	name: string;
+	paths: string[];
+}
+interface Manifest {
+	version: 1 | 2;
+	items: DesktopImportItem[];
+}
+type SessionContext = { sessionManager: { getCwd(): string } };
+const record = (value: unknown): value is Record<string, any> =>
+	!!value && typeof value === "object" && !Array.isArray(value);
+const missing = (error: unknown) => ["ENOENT", "ENOTDIR"].includes((error as NodeJS.ErrnoException).code ?? "");
+const normalized = (value: string) =>
+	process.platform === "win32" ? path.resolve(value).toLowerCase() : path.resolve(value);
+const manifestPath = () => path.join(getBaseConfigRoot(), "desktop-imports.json");
+const importsRoot = () => path.join(getBaseConfigRoot(), "imports");
+const itemRoot = (id: string) => path.join(importsRoot(), id);
+const legacyPath = (id: string) => path.join(getBaseConfigRoot(), "desktop-imports", id);
+const snapshotPath = (entry: DesktopImportItem) => path.join(itemRoot(entry.id), entry.revision!);
+
+function sources(cwd: string): Source[] {
+	const home = os.homedir();
+	const roots = (names: string[]) => [
+		...new Set(names.flatMap(name => [path.join(home, name), path.join(cwd, name)])),
+	];
+	const editorData =
+		process.platform === "win32"
+			? (process.env.APPDATA ?? path.join(home, "AppData", "Roaming"))
+			: process.platform === "darwin"
+				? path.join(home, "Library", "Application Support")
+				: (process.env.XDG_CONFIG_HOME ?? path.join(home, ".config"));
+	return [
+		{
+			id: "agents",
+			name: "Agent Skills",
+			paths: roots([".agent", ".agents"]),
+		},
+		{
+			id: "gemini",
+			name: "Gemini / Antigravity",
+			paths: [...roots([".gemini"]), path.join(cwd, ".agents", "mcp_config.json")],
+		},
+		{
+			id: "claude",
+			name: "Claude Code",
+			paths: [...roots([".claude"]), path.join(home, ".claude.json"), path.join(cwd, ".mcp.json")],
+		},
+		{
+			id: "codex",
+			name: "Codex",
+			paths: [...roots([".codex"]), path.join(home, ".agents", "skills"), path.join(cwd, ".agents", "skills")],
+		},
+		{
+			id: "trae",
+			name: "Trae",
+			paths: [
+				...roots([".trae"]),
+				...["Trae", "Trae CN"].map(name => path.join(editorData, name, "User", "mcp.json")),
+			],
+		},
+		{ id: "zcode", name: "ZCode", paths: [...roots([".zcode"]), path.join(cwd, "zcode.json")] },
+		{
+			id: "ccswitch",
+			name: "CC Switch",
+			paths: [path.join(home, ".cc-switch"), path.join(home, ".agents", "skills")],
+		},
+	];
+}
+
+function identity(file: string, kind: string, key = ""): string {
+	return createHash("sha256")
+		.update(`${normalized(file)}\0${kind}\0${key}`)
+		.digest("hex")
+		.slice(0, 32);
+}
+
+export function desktopImportId(sourcePath: string): string | undefined {
+	const relative = path.relative(importsRoot(), path.resolve(sourcePath));
+	const parts = relative.split(path.sep);
+	return parts.length >= 3 && /^[a-f0-9]{32}$/.test(parts[0]) && /^[a-f0-9]{64}$/.test(parts[1]) ? parts[0] : undefined;
+}
+
+async function readManifest(): Promise<Manifest> {
+	let content: string;
+	try {
+		content = await fs.readFile(manifestPath(), "utf8");
+	} catch (error) {
+		if (missing(error)) return { version: 2, items: [] };
+		throw error;
+	}
+	let parsed: unknown;
+	try {
+		parsed = JSON.parse(content);
+	} catch {
+		throw Error("导入记录格式无效，请保留原文件后修复 desktop-imports.json。");
+	}
+	if (!record(parsed) || ![1, 2].includes(parsed.version) || !Array.isArray(parsed.items)) throw Error("导入记录格式无效。");
+	for (const item of parsed.items) {
+		if (
+			!record(item) ||
+			!/^[a-f0-9]{32}$/.test(item.id) ||
+			!["skill", "mcp"].includes(item.kind) ||
+			typeof item.path !== "string" ||
+			!path.isAbsolute(item.path) ||
+			(parsed.version === 1 && identity(item.path, item.kind, item.key ?? "") !== item.id) ||
+			(item.revision !== undefined && (typeof item.revision !== "string" || !/^[a-f0-9]{64}$/.test(item.revision)))
+		)
+			throw Error("导入记录包含无效的资源引用。");
+	}
+	for (const item of parsed.items) { delete item.linkedPath; delete item.managedPath; }
+	return parsed as unknown as Manifest;
+}
+
+export interface DesktopImportOrigin {
+	importSource: string;
+	importPath: string;
+}
+
+export async function desktopImportOrigins(): Promise<ReadonlyMap<string, DesktopImportOrigin>> {
+	return new Map(
+		(await migratedManifest()).items.map(entry => [entry.id, { importSource: entry.source, importPath: entry.path }]),
+	);
+}
+
+async function publish(manifest: Manifest): Promise<void> {
+	await fs.mkdir(getBaseConfigRoot(), { recursive: true });
+	await writeFileAtomically(manifestPath(), `${JSON.stringify(manifest, null, 2)}\n`);
+}
+
+function item(
+	file: string,
+	kind: "skill" | "mcp",
+	name: string,
+	source: string,
+	adapter: Adapter,
+	key?: string,
+	description?: string,
+	warning?: string,
+): DesktopImportItem {
+	return {
+		id: identity(file, kind, key),
+		name,
+		kind,
+		source,
+		path: file,
+		adapter,
+		...(key ? { key } : {}),
+		...(description ? { description } : {}),
+		...(warning ? { warning } : {}),
+	};
+}
+
+async function skillItem(file: string, source: string): Promise<DesktopImportItem> {
+	const real = await fs.realpath(file);
+	const content = await fs.readFile(real, "utf8");
+	const { frontmatter } = parseFrontmatter(content, { source: real, level: "off" });
+	const name =
+		typeof frontmatter.name === "string" && frontmatter.name.trim()
+			? frontmatter.name.trim()
+			: path.basename(path.dirname(real));
+	if (/[\\/]/.test(name)) throw Error("技能名称不能包含路径分隔符。");
+	return item(
+		real,
+		"skill",
+		name,
+		source,
+		"skill",
+		undefined,
+		typeof frontmatter.description === "string" ? frontmatter.description : undefined,
+	);
+}
+
+async function mcpItems(file: string, source: string): Promise<DesktopImportItem[]> {
+	const real = await fs.realpath(file);
+	return (await discoverMcpSource(real, source)).map(row =>
+		item(real, "mcp", row.name, source, row.adapter, row.key, row.description, row.warning),
+	);
+}
+
+async function discover(
+	cwd: string,
+	args: Record<string, unknown>,
+): Promise<{ items: DesktopImportItem[]; message: string }> {
+	const presets = sources(cwd);
+	const selected = Array.isArray(args.sources)
+		? args.sources.filter((id): id is string => typeof id === "string")
+		: presets.map(source => source.id);
+	const targets = presets
+		.filter(source => selected.includes(source.id))
+		.flatMap(source => source.paths.map(file => ({ file, source: source.id })));
+	if (Array.isArray(args.paths))
+		for (const file of args.paths)
+			if (typeof file === "string" && file.trim())
+				targets.push({
+					file: path.resolve(file.trim().replace(/^~(?=[\\/])/, os.homedir())),
+					source: "manual",
+				});
+	const items = new Map<string, DesktopImportItem>();
+	const visited = new Set<string>();
+	let failures = 0;
+	const probe = async (file: string, source: string, skill = false) => {
+		try {
+			const real = await fs.realpath(file);
+			if (visited.has(`${skill}:${normalized(real)}`)) return;
+			visited.add(`${skill}:${normalized(real)}`);
+			for (const entry of skill ? [await skillItem(real, source)] : await mcpItems(real, source))
+				items.set(entry.id, entry);
+		} catch (error) {
+			if (!missing(error)) failures++;
+		}
+	};
+	const skillTree = async (directory: string, source: string, depth = 0, seen = new Set<string>()) => {
+		try {
+			const real = await fs.realpath(directory);
+			if (seen.has(normalized(real))) return;
+			seen.add(normalized(real));
+			await probe(path.join(real, "SKILL.md"), source, true);
+			// shortcut: 最多遍历六层技能目录，更深的技能可直接选择其目录。
+			if (depth >= 6) return;
+			for (const child of await fs.readdir(real, { withFileTypes: true }))
+				if (
+					!child.name.startsWith(".") &&
+					!["node_modules", "target", "build", "dist"].includes(child.name) &&
+					(child.isDirectory() || child.isSymbolicLink())
+				)
+					await skillTree(path.join(real, child.name), source, depth + 1, seen);
+		} catch (error) {
+			if (!missing(error)) failures++;
+		}
+	};
+	for (const target of targets) {
+		try {
+			const stat = await fs.stat(target.file);
+			if (stat.isFile()) {
+				await probe(target.file, target.source, path.basename(target.file) === "SKILL.md");
+				continue;
+			}
+			if (!stat.isDirectory()) continue;
+			const dirs = [
+				path.join(target.file, "skills"),
+				path.join(target.file, "config", "skills"),
+				path.join(target.file, "antigravity", "skills"),
+			];
+			if (path.basename(target.file) === "skills" || target.source === "manual") dirs.unshift(target.file);
+			for (const directory of dirs) await skillTree(directory, target.source);
+			await probe(path.join(target.file, "SKILL.md"), target.source, true);
+			for (const name of [
+				"mcp.json",
+				"mcp_config.json",
+				".mcp.json",
+				"settings.json",
+				"config.json",
+				"config.toml",
+				"zcode.json",
+				"cc-switch.db",
+				"cli/config.json",
+				"User/mcp.json",
+				"config/mcp_config.json",
+				"antigravity/mcp_config.json",
+			])
+				await probe(path.join(target.file, name), target.source);
+			if (target.source === "manual")
+				for (const preset of [
+					".agent",
+					".agents",
+					".gemini",
+					".claude",
+					".codex",
+					".trae",
+					".zcode",
+					".cc-switch",
+				]) {
+					await skillTree(path.join(target.file, preset, "skills"), preset.slice(1));
+					for (const name of [
+						"mcp.json",
+						"mcp_config.json",
+						".mcp.json",
+						"settings.json",
+						"config.json",
+						"config.toml",
+						"cc-switch.db",
+						"cli/config.json",
+						"User/mcp.json",
+						"config/mcp_config.json",
+						"antigravity/mcp_config.json",
+					])
+						await probe(path.join(target.file, preset, name), preset.slice(1));
+				}
+		} catch (error) {
+			if (!missing(error)) failures++;
+		}
+	}
+	return {
+		items: [...items.values()].sort((a, b) => a.name.localeCompare(b.name)),
+		message: failures ? `${failures} 个来源无法解析或访问，其余资源已列出。` : "发现完成。",
+	};
+}
+
+async function removeLegacyLink(entry: DesktopImportItem): Promise<void> {
+	try {
+		const previous = legacyPath(entry.id);
+		if (!(await fs.lstat(previous)).isSymbolicLink()) return;
+		const target = path.resolve(path.dirname(previous), await fs.readlink(previous));
+		if (normalized(target) === normalized(path.dirname(entry.path))) await fs.unlink(previous);
+	} catch (error) {
+		if (!missing(error)) throw error;
+	}
+}
+
+async function treeDigest(directory: string): Promise<string> {
+	const digest = createHash("sha256");
+	const visit = async (location: string, relative: string, parents: Set<string>) => {
+		const real = await fs.realpath(location);
+		const stat = await fs.stat(real);
+		if (stat.isDirectory()) {
+			if (parents.has(normalized(real))) throw Error("技能目录含有循环链接，请修复来源后重试。");
+			digest.update(`d\0${relative}\0`);
+			const next = new Set([...parents, normalized(real)]);
+			for (const name of (await fs.readdir(real)).sort()) await visit(path.join(real, name), `${relative}/${name}`, next);
+		} else if (stat.isFile()) {
+			digest.update(`f\0${relative}\0`).update(createHash("sha256").update(await fs.readFile(real)).digest());
+		} else throw Error("技能目录含有无法复制的特殊文件。");
+	};
+	await visit(directory, "", new Set());
+	return digest.digest("hex");
+}
+
+function sourceContext(entry: DesktopImportItem, cwd: string): string {
+	if (entry.key?.startsWith("[")) {
+		try {
+			const keys: unknown = JSON.parse(entry.key);
+			if (Array.isArray(keys) && keys[0] === "projects" && typeof keys[1] === "string" && path.isAbsolute(keys[1])) return keys[1];
+		} catch {}
+	}
+	const relative = path.relative(cwd, entry.path);
+	if (!relative.startsWith(`..${path.sep}`) && relative !== ".." && !path.isAbsolute(relative)) return cwd;
+	let directory = path.dirname(entry.path);
+	for (let parent = directory; path.dirname(parent) !== parent; parent = path.dirname(parent)) {
+		if ([".agent", ".agents", ".gemini", ".claude", ".codex", ".trae", ".zcode", ".cc-switch"].includes(path.basename(parent))) {
+			directory = path.dirname(parent);
+			return normalized(directory) === normalized(os.homedir()) ? cwd : directory;
+		}
+	}
+	return directory;
+}
+
+async function storeSnapshot(entry: DesktopImportItem, cwd: string): Promise<DesktopImportItem> {
+	const directory = itemRoot(entry.id);
+	await fs.mkdir(directory, { recursive: true });
+	if ((await fs.lstat(directory)).isSymbolicLink()) throw Error("受管副本目录被链接替代，请保留其内容后重试。");
+		for (const name of await fs.readdir(directory)) if (/^\.pending-[a-f0-9-]+$/.test(name)) await fs.rm(path.join(directory, name), { recursive: true, force: true });
+		const temporary = path.join(directory, `.pending-${crypto.randomUUID()}`);
+		await fs.mkdir(temporary);
+		try {
+			const context = entry.context ?? sourceContext(entry, cwd);
+			let revision: string;
+			let executionDirectory: string | undefined;
+			if (entry.kind === "skill") {
+				const sourceDirectory = path.dirname(entry.path);
+				const before = await treeDigest(sourceDirectory);
+				await fs.cp(sourceDirectory, temporary, { recursive: true, dereference: true });
+				revision = await treeDigest(temporary);
+				if (before !== revision || before !== await treeDigest(sourceDirectory)) throw Error("来源在复制期间发生变化，请重试导入。");
+			} else {
+				const config = await snapshotMcpSource(entry, entry.path, context);
+				executionDirectory = config.command ? config.cwd : undefined;
+				await writeFileAtomically(path.join(temporary, "mcp.json"), `${JSON.stringify(config, null, 2)}\n`);
+				revision = await treeDigest(temporary);
+			}
+			const destination = path.join(directory, revision);
+			try { await fs.rename(temporary, destination); }
+			catch (error) {
+				if (!["EEXIST", "ENOTEMPTY", "EPERM"].includes((error as NodeJS.ErrnoException).code ?? "") || await treeDigest(destination) !== revision) throw error;
+			}
+			return { ...entry, context, executionDirectory, revision, migrationPending: undefined, problem: undefined, warning: undefined };
+		} finally { await fs.rm(temporary, { recursive: true, force: true }); }
+}
+
+async function installEntry(entry: DesktopImportItem, cwd: string, preserveState = false): Promise<void> {
+	await fs.mkdir(importsRoot(), { recursive: true });
+	// 单项锁覆盖复制与提交，清单锁只保护一次文件写入。
+	await withFileLock(path.join(importsRoot(), `${entry.id}.install`), async () => {
+		const copied = await storeSnapshot(entry, cwd);
+		await saveEntry(copied, preserveState);
+		const current = (await readManifest()).items.find(item => item.id === entry.id);
+		for (const name of await fs.readdir(itemRoot(entry.id))) if (/^[a-f0-9]{64}$/.test(name) && name !== current?.revision) await fs.rm(path.join(itemRoot(entry.id), name), { recursive: true, force: true });
+	});
+}
+
+function disableSameName(manifest: Manifest, selected: DesktopImportItem): void {
+	if (selected.enabled) for (const item of manifest.items)
+		if (item.id !== selected.id && item.kind === selected.kind && item.name === selected.name) item.enabled = false;
+}
+
+async function saveEntry(entry: DesktopImportItem, requireExisting = false): Promise<void> {
+	await withFileLock(manifestPath(), async () => {
+		const manifest = await readManifest();
+		manifest.version = 2;
+		const index = manifest.items.findIndex(item => item.id === entry.id);
+		if (index < 0) {
+			if (requireExisting) return;
+			manifest.items.push(entry);
+		} else {
+			if (requireExisting && manifest.items[index].revision && !entry.revision) return;
+			manifest.items[index] = { ...entry, enabled: requireExisting ? manifest.items[index].enabled : entry.enabled };
+		}
+		disableSameName(manifest, manifest.items.find(item => item.id === entry.id)!);
+		await publish(manifest);
+	});
+}
+
+async function migratedManifest(cwd = process.cwd()): Promise<Manifest> {
+	let manifest = await readManifest();
+	if (manifest.version === 1) {
+		await withFileLock(manifestPath(), async () => {
+			const current = await readManifest();
+			if (current.version === 1) await publish({ version: 2, items: current.items.map(entry => ({ ...entry, migrationPending: true })) });
+		});
+		manifest = await readManifest();
+	}
+	for (const entry of manifest.items) {
+		if (entry.migrationPending) {
+			try {
+				await installEntry(entry, cwd, true);
+			} catch (error) {
+				await saveEntry({ ...entry, migrationPending: false, problem: missing(error) ? "原来源已不存在，请重新选择该技能目录或 MCP 配置文件恢复副本。" : "旧资源未能复制，请检查来源后重试迁移，或重新选择来源。" }, true);
+			}
+		}
+	}
+	manifest = await readManifest();
+	for (const entry of manifest.items) if (entry.revision) await removeLegacyLink(entry).catch(() => {});
+	return manifest;
+}
+
+async function listed(cwd?: string): Promise<DesktopImportItem[]> {
+	return Promise.all((await migratedManifest(cwd)).items.map(async entry => {
+		if (!entry.revision) return { ...entry, problem: entry.problem ?? "副本尚未完成，请重新选择来源恢复。" };
+		const managedPath = source(entry).path;
+		try { await fs.access(managedPath); return { ...entry, managedPath }; }
+		catch { return { ...entry, managedPath, problem: "受管副本已不存在，请从来源重新复制，或重新选择来源。" }; }
+	}));
+}
+
+export async function manageDesktopImports(
+	session: SessionContext,
+	action: string,
+	args: Record<string, unknown> = {},
+): Promise<{ items: DesktopImportItem[] | Source[]; message?: string; restartRequired?: boolean }> {
+	const cwd = session.sessionManager.getCwd();
+	if (action === "sources") return { items: sources(cwd) };
+	if (action === "discover") {
+		const found = await discover(cwd, args);
+		const imported = await listed(cwd);
+		return { ...found, items: found.items.map(entry => ({ ...entry, managedPath: imported.find(saved => saved.kind === entry.kind && saved.path === entry.path && saved.key === entry.key)?.managedPath })) };
+	}
+	if (action === "list") return { items: await listed(cwd) };
+	if (!["install", "update", "repair", "enable", "disable", "remove"].includes(action)) throw Error("未知的导入操作。");
+	await fs.mkdir(getBaseConfigRoot(), { recursive: true });
+	const manifest = await migratedManifest(cwd);
+	if (action === "install") {
+		if (!Array.isArray(args.items)) throw Error("请选择要导入的资源。");
+		for (const candidate of args.items) {
+			if (!record(candidate) || !["skill", "mcp"].includes(candidate.kind) || typeof candidate.path !== "string" || !path.isAbsolute(candidate.path)) throw Error("导入来源无效。");
+			const found = candidate.kind === "skill" ? [await skillItem(candidate.path, String(candidate.source ?? "manual"))] : await mcpItems(candidate.path, String(candidate.source ?? "manual"));
+			const entry = found.find(entry => entry.id === candidate.id);
+			if (!entry) throw Error("此资源已变更，请重新发现后导入。");
+			if (entry.warning) throw Error(entry.warning);
+			const existing = manifest.items.find(saved => saved.id === entry.id);
+			await installEntry({ ...entry, enabled: existing?.enabled ?? true }, cwd);
+		}
+	} else {
+		if (typeof args.id !== "string" || !/^[a-f0-9]{32}$/.test(args.id)) throw Error("请选择导入记录。");
+		const entry = manifest.items.find(item => item.id === args.id);
+		if (action === "remove") {
+			await fs.mkdir(importsRoot(), { recursive: true });
+			await withFileLock(path.join(importsRoot(), `${args.id}.install`), async () => {
+				await withFileLock(manifestPath(), async () => {
+					const current = await readManifest();
+					current.items = current.items.filter(item => item.id !== args.id);
+					await publish(current);
+				});
+				await fs.rm(itemRoot(args.id as string), { recursive: true, force: true });
+				if (entry) await removeLegacyLink(entry);
+			});
+		} else {
+			if (!entry) throw Error("此导入记录已不存在。");
+			if (action === "update" || action === "repair") {
+				const file = typeof args.path === "string" && args.path ? args.path : entry.path;
+				const selected = entry.kind === "skill" ? [await skillItem(path.basename(file) === "SKILL.md" ? file : path.join(file, "SKILL.md"), entry.source)] : await mcpItems(file, entry.source);
+				const replacement = selected.find(item => item.key === entry.key && item.name === entry.name) ?? selected.find(item => item.name === entry.name);
+				if (!replacement) throw Error("所选来源中没有找到同名资源，请重新选择。");
+				if (replacement.warning) throw Error(replacement.warning);
+				await installEntry({ ...replacement, id: entry.id, enabled: entry.enabled, context: action === "repair" ? undefined : entry.context }, cwd, true);
+				await removeLegacyLink(entry);
+			} else {
+				if (action === "enable" && (!entry.revision || entry.problem)) throw Error(entry.problem ?? "请先恢复资源副本。");
+				await withFileLock(manifestPath(), async () => {
+					const current = await readManifest();
+					const selected = current.items.find(item => item.id === entry.id);
+					if (!selected) throw Error("此导入记录已不存在。");
+					selected.enabled = action === "enable";
+					disableSameName(current, selected);
+					await publish(current);
+				});
+			}
+		}
+	}
+	return { items: await listed(cwd), message: action === "install" ? "已复制并启用，连接会话后即可使用。" : "已保存。", restartRequired: true };
+}
+
+function source(entry: DesktopImportItem): SourceMeta {
+	return {
+		provider: "desktop-imports",
+		providerName: "手动导入",
+		path: path.join(snapshotPath(entry), entry.kind === "skill" ? "SKILL.md" : "mcp.json"),
+		level: "user",
+	};
+}
+
+export async function loadDesktopImportSkills(): Promise<LoadResult<Skill>> {
+	const items: Skill[] = [];
+	const warnings: string[] = [];
+	for (const entry of (await migratedManifest()).items.filter(entry => entry.enabled && entry.kind === "skill")) {
+		try {
+			if (!entry.revision) throw Error(entry.problem ?? "副本尚未完成");
+			const skillPath = source(entry).path;
+			const { frontmatter, body } = parseFrontmatter(await fs.readFile(skillPath, "utf8"), {
+				source: skillPath,
+				level: "off",
+			});
+			frontmatter.enabled = true;
+			items.push({
+				name: entry.name,
+				path: skillPath,
+				content: body,
+				frontmatter,
+				level: "user",
+				_source: source(entry),
+			});
+		} catch {
+			warnings.push(`无法读取已导入技能：${entry.name}`);
+		}
+	}
+	return { items, warnings };
+}
+
+export async function loadDesktopImportMcps(cwd: string): Promise<LoadResult<MCPServer>> {
+	const items: MCPServer[] = [];
+	const warnings: string[] = [];
+	for (const entry of (await migratedManifest(cwd)).items.filter(entry => entry.enabled && entry.kind === "mcp")) {
+		try {
+			if (!entry.revision) throw Error(entry.problem ?? "副本尚未完成");
+			const meta = source(entry);
+			const config: Omit<MCPServer, "_source"> = JSON.parse(await fs.readFile(meta.path, "utf8"));
+			items.push({ ...config, enabled: true, _source: meta });
+		} catch (error) {
+			warnings.push(`无法读取已导入 MCP：${entry.name}：${error instanceof Error ? error.message : String(error)}`);
+		}
+	}
+	return { items, warnings };
+}
+
+registerProvider(skillCapability.id, {
+	id: "desktop-imports",
+	displayName: "手动导入",
+	description: "仅加载已导入并启用的技能",
+	priority: 110,
+	load: loadDesktopImportSkills,
+});
+registerProvider(mcpCapability.id, {
+	id: "desktop-imports",
+	displayName: "手动导入",
+	description: "仅加载已导入并启用的 MCP 服务",
+	priority: 110,
+	load: ctx => loadDesktopImportMcps(ctx.cwd),
+});
diff --git a/packages/coding-agent/src/discovery/desktop-import-mcp.ts b/packages/coding-agent/src/discovery/desktop-import-mcp.ts
